function simSVG(id,title){return `<div class="sim"><h3>${title}</h3><svg viewBox="0 0 660 175" role="img" aria-label="${title}二維教學動畫"><defs><pattern id="grid-${id}" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" fill="none" stroke="#e5edf5"/></pattern></defs><rect width="660" height="175" fill="url(#grid-${id})"/><path d="M60 95H600" stroke="#a7b7c9" stroke-width="4" stroke-dasharray="6 6"/><circle cx="60" cy="95" r="8" fill="#55738f"/><rect x="585" y="68" width="35" height="52" rx="6" fill="#dceee6" stroke="#398563"/><text x="30" y="145" font-size="15" fill="#42586f">起點</text><text x="560" y="145" font-size="15" fill="#42586f">交接座</text><g id="obstacle-${id}" opacity="0"><rect x="312" y="45" width="36" height="80" rx="12" fill="#f3ae8c"/><text x="270" y="28" font-size="15" fill="#a04e21">助手佔區</text></g><g id="tool-${id}" transform="translate(60 95)"><circle r="17" fill="${id==='gate'?'#087d75':'#537799'}"/><path d="M-5 0H27" stroke="white" stroke-width="5" stroke-linecap="round"/></g></svg><p id="status-${id}" class="note">尚未執行</p></div>`;}
function medical(){return head('STATION 02','同一套情境，才能比較方法的差異','互動區是可檢查的二維教學運動模型；歷史 300 組物理模擬摘要另列，不混算。')+`<div class="grid"><section class="panel"><h2>配對情境</h2><div class="field"><label for="motion-case">事件種類</label><select id="motion-case">${Object.entries(Q.motionScenarios).map(([k,v])=>`<option value="${k}" ${motionKey===k?'selected':''}>${v.name}</option>`).join('')}</select></div><div class="field"><label for="latency">偵測延遲：<span id="latency-value">${latency.toFixed(2)}</span> 教學秒</label><input id="latency" type="range" min="0" max="1.2" step="0.05" value="${latency}"></div><p class="note">單位是螢幕像素與教學秒。未校正到真機，不可用於決定安全距離、速度或控制參數。</p><button class="btn primary full" id="motion-run">同時執行有／無閘門</button><div class="btn-group"><button class="btn" id="motion-pause">暫停動畫</button><button class="btn" id="motion-replay">重播結果</button></div><hr style="border:0;border-top:1px solid var(--line)"><h3>固定種子的配對批次</h3><div class="field"><label for="seed">情境種子（整數）</label><input id="seed" type="number" min="0" max="4294967295" value="${batch?batch.seed:20261113}"></div><button class="btn teal full" id="batch-run">執行 24 組教學情境</button><button class="btn full" style="margin-top:10px" id="batch-csv" ${batch?'':'disabled'}>匯出逐情境 CSV</button><div id="motion-error" role="alert"></div></section><div class="stack"><section class="panel"><div class="pill warn">二維教學示例／非 MuJoCo、非 PPO、非真機</div><div class="two" style="margin-top:14px">${simSVG('gate','有執行閘門')}${simSVG('open','無執行閘門')}</div><label class="field" for="motion-time">逐時刻檢查<input class="timeline" id="motion-time" type="range" min="0" max="14" step="0.025" value="0"></label><p id="motion-caption" class="note">兩邊使用同一事件、初始位置與延遲，僅改變執行監督。</p><div id="batch-result">${batch?batchHTML():''}</div></section><section class="panel"><h2>歷史研究結果：只作來源對照</h2><p class="note">來源：2026-11-02 醫械智取隊修訂稿表 15。每條件 300 組配對情境，既有 RRT-Connect 閉迴路物理模擬。這裡不含原始逐試次資料，也未重算配對顯著性。</p><div class="table-scroll"><table><thead><tr><th>條件／配置</th><th>成功率</th><th>模擬不安全率</th><th>原報均時</th></tr></thead><tbody>${Q.historical.conditions.map(c=>c.rows.filter(r=>['C','D','E'].includes(r[0])).map(r=>`<tr><td>${c.name} ${r[0]}</td><td>${r[1].toFixed(1)}%</td><td>${r[2].toFixed(1)}%</td><td>${r[3].toFixed(1)} 秒</td></tr>`).join('')).join('')}</tbody></table></div><p class="note">C＝人工複核流程＋閘門；D＝主動近拍＋閘門；E＝主動近拍、無閘門。歷史均時的成功／失敗分母未在此獨立確認，不能直接換算真人減負。</p>${quiz('medical','五種配置共用 300 組情境，應如何解讀？',['1,500 次執行就是 1,500 個獨立樣本。','保留情境配對，逐組比較方法差異。'],1,'執行次數、獨立情境與真人受試者數是不同單位。')}</section></div></div>`;}
const statusNames={success:'抵達目標',unsafe_event:'出現教學模型的碰撞事件',timeout:'等待逾時，任務中止'};
function paintMotion(t){if(!pair)return;['gate','open'].forEach(k=>{const r=pair[k],f=r.trace[Math.min(Math.floor(t/.025),r.trace.length-1)];$('tool-'+k).setAttribute('transform',`translate(${f.x} 95)`);$('obstacle-'+k).setAttribute('opacity',f.active?'1':'0');$('obstacle-'+k).setAttribute('transform',`translate(${r.spec.obstacle-330} 0)`);$('status-'+k).textContent=t>=r.time?`${statusNames[r.status]}｜${r.time.toFixed(2)} 教學秒｜介入 ${r.interventions} 次`:`${f.brake?(f.v<1?'等待解除':'減速中'):'前進中'}｜t=${t.toFixed(2)}`;});$('motion-time').value=t;$('motion-caption').textContent='教學事件時間 '+t.toFixed(2)+'；模擬器未描述完整手臂幾何、接觸力或臨床安全。';}
function play(){if(!pair)return;if(timer)clearInterval(timer);let t=0;const max=Math.max(pair.gate.time,pair.open.time);$('motion-time').max=max;paintMotion(t);timer=setInterval(()=>{t=Math.min(max,t+.10);paintMotion(t);if(t>=max){clearInterval(timer);timer=null;}},35);}
function batchHTML(){const b=batch;return `<div class="callout"><b>新產生的教學結果，與上方歷史數值分開。</b><br>種子 ${b.seed}，${b.n} 組情境、${b.n*2} 次執行。僅切換閘門，不含真人複核。</div><div class="table-scroll"><table><thead><tr><th>配置</th><th>完成</th><th>碰撞</th><th>逾時</th><th>全試次均時*</th></tr></thead><tbody>${[['有閘門',b.with_gate],['無閘門',b.without_gate]].map(([n,r])=>`<tr><td>${n}</td><td>${r.success}/${b.n}</td><td>${r.unsafe}/${b.n}</td><td>${r.timeout}/${b.n}</td><td>${r.mean_all_attempt_time.toFixed(2)}</td></tr>`).join('')}</tbody></table></div><p class="note">* 碰撞立即結束，逾時固定為14教學秒；失敗提早結束可能讓原始均時更短，不能據此宣稱效率較佳。</p><div class="endpoints"><span>兩邊都完成 ${b.counts.both_success}</span><span>僅有閘門完成 ${b.counts.gate_only}</span><span>僅無閘門完成 ${b.counts.no_gate_only}</span><span>兩邊未完成 ${b.counts.both_not_success}</span></div>`;}
function bindMedical(){$('motion-case').onchange=e=>{motionKey=e.target.value;};$('latency').oninput=e=>{latency=Number(e.target.value);$('latency-value').textContent=latency.toFixed(2);};$('motion-run').onclick=()=>{pair={gate:Q.simulateMotion(motionKey,true,latency),open:Q.simulateMotion(motionKey,false,latency)};session.results.medical={evidence_kind:'synthetic_2d_teaching_model',scenario:motionKey,latency,with_gate:pair.gate.status,without_gate:pair.open.status};event('paired_motion',{scenario:motionKey,latency});play();};$('motion-pause').onclick=()=>{if(timer)clearInterval(timer);timer=null;};$('motion-replay').onclick=play;$('motion-time').oninput=e=>{if(timer)clearInterval(timer);timer=null;paintMotion(Number(e.target.value));};$('batch-run').onclick=()=>{try{const value=$('seed').value;if(value.trim()==='')throw new Error('請輸入種子');batch=Q.pairedBatch(Number(value),24,latency);session.results.medical=batch;event('paired_batch',{seed:batch.seed,n:batch.n});render();}catch(e){$('motion-error').textContent=e.message;}};$('batch-csv').onclick=()=>{if(!batch)return;const lines=['evidence_kind,seed,scenario_id,event,with_gate_status,without_gate_status,with_gate_time,without_gate_time'];batch.rows.forEach(r=>lines.push(['synthetic_teaching',batch.seed,r.scenario_id,r.kind,r.with_gate.status,r.without_gate.status,r.with_gate.time,r.without_gate.time].join(',')));saveFile('quality-lab-paired-teaching.csv','\ufeff'+lines.join('\n'),'text/csv;charset=utf-8');};if(pair)paintMotion(0);}
const depNames={ready:'可提供',missing_structure:'缺少教案結構',unpublished:'未列入發布',source_mismatch:'來源版本不同',corrupt_media:'檔案損毀被攔截',false_ready:'誤宣告可播放'};
function deployment(){return head('STATION 03','測試通過，也可能沒有驗收使用者的完整流程','依平台已記錄的缺陷，建立28張簡化教案卡。每張只有一個教學檢查單位，不是112組職類任務的完整重建。')+`<div class="grid"><section class="panel"><h2>部署條件</h2><div class="field"><label for="dep-env">執行環境</label><select id="dep-env"><option value="clean" ${depOptions.environment==='clean'?'selected':''}>新機／乾淨安裝</option><option value="developer" ${depOptions.environment==='developer'?'selected':''}>開發者原電腦</option></select></div>${[['coverAll','影片計畫涵蓋全部 28 教案'],['portable','補入 7 份可攜教案結構'],['versionAligned','建置與執行用同一調適快照'],['strictIntegrity','核對媒體完整性（非修復）']].map(([k,l])=>`<label class="check"><input type="checkbox" id="dep-${k}" ${depOptions[k]?'checked':''}>${l}</label>`).join('')}<div class="btn-group"><button class="btn" id="dep-old">只跑舊檢查：9 情境</button><button class="btn primary" id="dep-all">驗收全部 28 教案</button></div><button class="btn teal full" id="dep-fix">套用完整發布修正並驗收</button><div class="btn-group"><button class="btn" id="dep-corrupt">注入一個損毀檔案</button><button class="btn" id="dep-reset">重現原始缺口</button></div><p class="note">故障與修正只修改這個頁面的示例狀態，不會更動您的正式教案或雲端平台。</p></section><div class="stack"><section class="panel"><h2>檢查範圍與實際可用狀態</h2><div id="dep-result">${depResult?deploymentHTML():'<div class="empty">先按「只跑舊檢查」，再驗收全部教案。</div>'}</div><div id="course-detail" class="callout">點選教案卡，可追查缺失原因。</div></section><section class="panel"><h2>這個故事來自哪些已記錄改善？</h2><p>原檢查只涵蓋 9 個新情境，而介面仍可選取 19 個舊教案。後續擴大為 28 教案、103 組職類任務，加上 9 組社工導讀：112 組、336 支影片。</p><p>另補入 7 份只存在本機的教案結構，並以相同來源調適、媒體校驗與乾淨安裝檢查配對。手機端採圖片優先，避免影片或 WebGL 失敗阻斷逐格學習。</p><p class="note">本頁沒有生成或複製336支影片，也不含病患與學員資料。數字是來源文件的歷史記錄。</p>${quiz('deployment','應從哪裡建立發布驗收清單？',['只驗證已經產製的影片清單。','從使用者可達的教案、職類與版本建立清單。'],1,'測試母集合應對應實際使用範圍；校驗能攔截損毀，不能代替內容修復。')}</section></div></div>`;}
function deploymentHTML(){const r=depResult;return `<div class="metrics"><div class="metric"><b>${r.claimed}/${r.checked}</b><span>目前檢查宣告可播</span></div><div class="metric"><b>${r.checked}/28</b><span>驗收涵蓋範圍</span></div><div class="metric"><b>${r.actual}/${r.checked}</b><span>示例中實際可用</span></div></div><div class="callout ${r.releaseAccepted?'success':'warn'}" role="status"><b>${r.releaseAccepted?'完整示例驗收通過':'尚不足以接受完整發布'}</b><br>${!r.scopeComplete?'原檢查只涵蓋9個情境，即使9/9通過，也沒有檢查剩下19個教案。':r.releaseAccepted?'28張卡片符合本教學版的來源與媒體條件；不是正式臨床或裝置驗收。':'查看橘色卡片，分辨未發布、隱藏依賴、來源不符與媒體損毀。'}</div><div class="course-grid">${Array.from({length:28},(_,i)=>{const row=r.rows.find(x=>x.id===i+1);return `<button class="course ${row?(row.status==='ready'?'ready':'issue'):''}" data-course="${i+1}" aria-label="教案 ${i+1}：${row?depNames[row.status]:'未檢查'}">${String(i+1).padStart(2,'0')}<br>${row?(row.status==='ready'?'通過':'缺口'):'未檢'}</button>`;}).join('')}</div><div class="legend"><span>綠：示例可提供</span><span>橘：需處理或誤宣告</span><span>灰：未進入檢查</span></div>`;}
function bindDeployment(){$('dep-env').onchange=e=>{depOptions.environment=e.target.value;depResult=null;render();};['coverAll','portable','versionAligned','strictIntegrity'].forEach(k=>$('dep-'+k).onchange=e=>{depOptions[k]=e.target.checked;depResult=null;render();});function run(scope){depResult=Q.deploymentCheck({...depOptions,scope});session.results.deployment=depResult;event('deployment_check',{scope,options:{...depOptions},accepted:depResult.releaseAccepted});render();}$('dep-old').onclick=()=>run('legacy');$('dep-all').onclick=()=>run('all');$('dep-fix').onclick=()=>{depOptions={...depOptions,coverAll:true,portable:true,versionAligned:true,corrupt:false,strictIntegrity:true};event('apply_release_fix');run('all');};$('dep-corrupt').onclick=()=>{depOptions.corrupt=true;event('inject_media_corruption');run('all');};$('dep-reset').onclick=()=>{depOptions={environment:'clean',coverAll:false,portable:false,versionAligned:false,corrupt:false,strictIntegrity:true};depResult=null;render();};document.querySelectorAll('[data-course]').forEach(b=>b.onclick=()=>{const row=depResult.rows.find(x=>x.id===Number(b.dataset.course));$('course-detail').textContent=row?`${row.name}｜${depNames[row.status]}：${row.reason}`:`教案 ${b.dataset.course} 尚未進入檢查。`;event('inspect_course',{id:Number(b.dataset.course)});});}
