function report(){const done=Object.keys(session.results).length;return head('LEARNING RECORD','帶走您的品質判斷紀錄','只記錄此頁的操作與答案；不收集姓名、不上傳資料，也不把活動數轉成正式能力分數。','本機課堂活動')+`<div class="stack"><section class="panel"><div class="metrics"><div class="metric"><b>${done}/3</b><span>已執行體驗</span></div><div class="metric"><b>${session.events.length}</b><span>頁面活動事件</span></div><div class="metric"><b>${Object.values(session.answers).filter(a=>a.correct).length}/3</b><span>目前概念題答對</span></div></div><div class="table-scroll"><table><thead><tr><th>研究案例</th><th>本輪活動</th><th>要帶回現場的問題</th></tr></thead><tbody><tr><td>DrawIQ</td><td>${session.results.drawiq?'已檢查修正適用性':'尚未執行'}</td><td>來源與目標條件是否一致？</td></tr><tr><td>醫療器械</td><td>${session.results.medical?'已執行教學配對':'尚未執行'}</td><td>比較是否保留情境與失敗成本？</td></tr><tr><td>教學平台</td><td>${session.results.deployment?'已執行部署檢查':'尚未執行'}</td><td>測試範圍是否涵蓋使用者流程？</td></tr></tbody></table></div><div class="btn-group screen-only"><button class="btn primary" id="export-json">匯出完整活動 JSON</button><button class="btn" id="print-report">列印／存成 PDF</button><button class="btn" id="clear-session">清除本輪活動</button></div><p class="note">重新整理會清除未匯出的活動。沒有雲端回收表、追蹤程式或背景上傳。</p></section><section class="panel"><h2>操作後自評（選填）</h2><p>回想剛才的體驗：0 代表很低，10 代表很高。這是自製課堂回饋，不是 NASA-TLX、臨床診斷或經驗證量表。</p>${[['mental','理解與判斷負擔'],['physical','操作身體負擔'],['frustration','挫折程度'],['control','知道如何處理問題']].map(([k,l])=>`<div class="rating"><label for="rating-${k}">${l}</label><input id="rating-${k}" type="range" min="0" max="10" value="${session.ratings?session.ratings[k]:5}"><output id="out-${k}">${session.ratings?session.ratings[k]:5}</output></div>`).join('')}<button class="btn" id="save-rating">儲存這次自評到本輪紀錄</button><p id="rating-state" class="note" role="status">${session.ratings?'已記錄自評。':'尚未記錄；預設滑桿值不會自動作為答案。'}</p></section><section class="panel"><h2>講者帶領方式</h2><p><b>第一站：</b>先用上限／下限錯配讓學員做選擇，再切換補強規則。</p><p><b>第二站：</b>先跑及早闖入，再選晚闖入或持續佔區；討論為什麼閘門不代表零失敗。</p><p><b>第三站：</b>先展示9/9通過，再查全部28教案，最後套用修正並注入損毀檔案。</p><div class="callout">共同問題：它省下了什麼工作，又新增了哪些覆核、等待、監督與復原？只有實際對照量測，才能主張人的負荷降低。</div></section></div>`;}
function bindReport(){$('export-json').onclick=()=>saveFile('quality-lab-activity.json',JSON.stringify({...session,exported_at:new Date().toISOString()},null,2));$('print-report').onclick=()=>window.print();$('clear-session').onclick=()=>{if(window.confirm('清除此頁本輪活動？已下載的檔案不受影響。')){session.events=[];session.answers={};session.results={};session.ratings=null;drawResult=null;adoption=null;pair=null;batch=null;depResult=null;render();}};['mental','physical','frustration','control'].forEach(k=>$('rating-'+k).oninput=e=>$('out-'+k).textContent=e.target.value);$('save-rating').onclick=()=>{session.ratings={};['mental','physical','frustration','control'].forEach(k=>session.ratings[k]=Number($('rating-'+k).value));event('optional_feedback',{measure:'unvalidated_classroom_self_report'});$('rating-state').textContent='已記錄；請匯出 JSON 保存。';};}
function sources(){return head('EVIDENCE & OPEN SOURCE','研究證據、互動示例與開源範圍','這份教學版取用鄭淳詩研究中的問題與已記錄摘要，沒有複製未公開客戶圖面、病患資料、模型權重或正式平台。','MIT · 僅本教學程式')+`<div class="sources"><section><h2>D01｜DrawIQ 修正重用</h2><p>依據：DrawIQ_Manuscript_Revised_20261105 與 S2 evidence audit（2026-11-05），封存研究版本0.4.8、2026-10-05機制紀錄。</p><p>歷史記錄包含26個生成圖、20個匹配探針與63個相關API觀察；2個預定匹配和3個語意邊界產生建議，15個排除。這些不是辨識準確率。</p><p>本頁7個案例是重新編寫的最小教學規則；補強開關只在本教學版生效。原稿與受限材料由作者管理，本程式不再發布原始圖面。</p></section><section><h2>M01｜醫療器械配對物理模擬</h2><p>依據：附件四_醫械智取隊_視覺與強化學習_學術技術修訂，2026-11-02，表15與附錄B。</p><p>歷史比較是合成視覺與RRT-Connect控制；每條件300組配對情境。3,000次配置執行不等於3,000個獨立個案。原報均時的成功／失敗分母尚未在本包核對。</p><p>互動動畫及24組批次是新的二維玩具模型，未配適歷史百分比；不含MuJoCo、PPO、實體機器人、真實碰撞或力學驗證。</p></section><section><h2>T01｜教學平台影片部署</h2><p>依據：spiral-clinical-tutor-v5，〈v5.6.3 講師影片配對與部署修正〉，2026-10-24，固定程式版本 ce0c7cb764a26fb7bc68bdab813d88c47bef7e45。</p><p>記錄9個新情境、19個舊教案的覆蓋缺口；其後28教案、112組／336影片，並補入7份可攜教案結構。此頁以28張合成卡片說明缺陷，沒有複製正式教材。</p><a href="https://github.com/poemcheng/spiral-clinical-tutor-v5/blob/ce0c7cb764a26fb7bc68bdab813d88c47bef7e45/README.md" target="_blank" rel="noopener">查閱原平台公開文件 ↗</a></section><section><h2>開源與離線使用</h2><p>本教學程式採MIT授權；上游研究、第三方素材與原平台仍保留各自授權。您可保留授權聲明後修改及再部署本教學程式。</p><div class="btn-group"><a class="btn primary" href="https://github.com/poemcheng/poem/tree/master/quality-collaboration-lab" target="_blank" rel="noopener">GitHub 原始碼</a><a class="btn" href="./source.zip" download>下載本版原始碼 ZIP</a><button class="btn" id="download-offline">下載可離線使用的 HTML</button><a class="btn" href="./docs/GUIDE.md" target="_blank" rel="noopener">講者與學員指引</a></div><p class="note">HTML不依賴CDN、帳號或金鑰。頁內互動不向外送資料；點選外部GitHub連結時才連往外站。本版未覆寫原Sites網站或正式研究專案。</p></section></div>`;}
function bindSources(){$('download-offline').onclick=()=>{const cloned=document.documentElement.cloneNode(true);cloned.querySelectorAll('.toast').forEach(n=>n.remove());saveFile('quality-collaboration-lab-offline.html','<!doctype html>\n'+cloned.outerHTML,'text/html;charset=utf-8');};}
document.querySelectorAll('nav [data-page]').forEach(b=>b.onclick=()=>navigate(b.dataset.page));window.addEventListener('hashchange',()=>navigate(location.hash.slice(1)));window.addEventListener('pagehide',()=>{if(timer)clearInterval(timer);});navigate(location.hash.slice(1)||'home');
})();
