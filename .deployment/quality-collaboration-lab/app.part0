/* UI is a dependency-free teaching companion. All activity stays in this browser. */
(function(){'use strict';
const Q=window.QualityLab,$=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const session={version:Q.VERSION,started_at:new Date().toISOString(),evidence_kind:'classroom_activity_not_research_validation',events:[],answers:{},ratings:null,results:{}};
let station='home',timer=null,drawId='operator',drawPolicy={operator:false,state:false,source:true},drawResult=null,adoption=null;
let motionKey='early',latency=.15,pair=null,batch=null;let depOptions={environment:'clean',coverAll:false,portable:false,versionAligned:false,corrupt:false,strictIntegrity:true},depResult=null;
function event(action,details={}){session.events.push({station,action,at:new Date().toISOString(),...details});}
function toast(msg){const n=document.createElement('div');n.className='toast';n.setAttribute('role','status');n.textContent=msg;document.body.appendChild(n);setTimeout(()=>n.remove(),2600);}
function saveFile(name,text,type='application/json'){const blob=new Blob([text],{type}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500);}
const titles={home:'總覽',drawiq:'01 工程圖重用',medical:'02 配對模擬',deployment:'03 部署驗收',report:'學習紀錄',sources:'證據與開源'};
function navigate(key){if(!titles[key])key='home';if(timer){clearInterval(timer);timer=null;}station=key;history.replaceState(null,'','#'+key);document.querySelectorAll('nav button').forEach(b=>b.setAttribute('aria-current',b.dataset.page===key?'page':'false'));render();window.scrollTo(0,0);}
function head(num,title,desc,badge='互動教學示例'){return `<div class="section-head"><div><div class="eyebrow">${num}</div><h1>${title}</h1><p>${desc}</p></div><span class="badge">${badge}</span></div>`;}
function quiz(id,question,answers,correct,explanation){return `<div class="quiz"><h3>${question}</h3>${answers.map((a,i)=>`<button class="btn" data-quiz="${id}" data-choice="${i}" data-correct="${correct}" data-explain="${esc(explanation)}">${a}</button>`).join('')}<p id="quiz-${id}" role="status">${session.answers[id]?esc(session.answers[id].feedback):''}</p></div>`;}
function bindQuiz(){document.querySelectorAll('[data-quiz]').forEach(b=>b.onclick=()=>{const correct=b.dataset.choice===b.dataset.correct,feedback=(correct?'判斷正確。':'再想一想。')+b.dataset.explain;session.answers[b.dataset.quiz]={choice:Number(b.dataset.choice),correct,feedback};$('quiz-'+b.dataset.quiz).textContent=feedback;event('answer',{question:b.dataset.quiz,correct});});}
function render(){const renderers={home:home,drawiq:drawiq,medical:medical,deployment:deployment,report:report,sources:sources};$('app').innerHTML=renderers[station]();bindQuiz();document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>navigate(b.dataset.go));({drawiq:bindDraw,medical:bindMedical,deployment:bindDeployment,report:bindReport,sources:bindSources}[station]||(()=>{}))();}
function home(){const done=Object.keys(session.results).length;return `<section class="hero"><div><div class="eyebrow">品質協作實驗室 · 研究衍生教學版</div><h1>讓系統做對事，<br>也讓人的工作更容易。</h1><p>從三個研究案例出發，親手找出不適用的修正、比較同一情境的機器反應，再驗收一份真正可交付的教材。</p><button class="hero-link" data-go="drawiq">從第一站開始 →</button><p class="note" style="color:#c3d3e2">免登入 · 不需 API 金鑰 · 全部互動在瀏覽器執行</p></div><div class="diagram"><div class="chain"><div><b>01</b><span>工程圖：建議適用於現在的要求嗎？</span></div><div><b>02</b><span>機器人：什麼條件才允許繼續動作？</span></div><div><b>03</b><span>教學：學員真的走得完整個流程嗎？</span></div></div><p style="font-size:13px">工作品質 ＋ 完整流程 ＋ 人的負荷</p></div></section><div class="cards"><section class="card"><div class="num">01 / TRACE</div><h2>DrawIQ<br>錯誤重用邊界</h2><p>切換上限、下限與衝突狀態，觀察規則為何可能通過，卻不適合提出建議。</p><span class="note">產出：判斷紀錄與待審狀態</span><button class="btn primary" data-go="drawiq">檢查一筆修正</button></section><section class="card"><div class="num">02 / VERIFY</div><h2>醫療器械<br>配對比較</h2><p>讓兩種配置面對相同障礙事件，觀察停止、恢復、碰撞與逾時。</p><span class="note">產出：24 組教學情境配對表</span><button class="btn primary" data-go="medical">執行配對體驗</button></section><section class="card"><div class="num">03 / DELIVER</div><h2>虛擬人教學平台<br>部署驗收</h2><p>看到 9/9 通過之後，再檢查全部 28 個教案，以及新機沒有的本機檔案。</p><span class="note">產出：驗收缺口與修正清單</span><button class="btn primary" data-go="deployment">找出部署缺陷</button></section></div><section class="panel"><h2>完成三站，帶走一份品質判斷紀錄</h2><div class="progress" aria-label="已執行 ${done} 個體驗"><span style="width:${done/3*100}%"></span></div><p>已執行 ${done}/3 站。可匯出本機活動 JSON、配對比較 CSV，或列印學習紀錄。結果不是能力認證，也不構成正式人因研究。</p><div class="flow"><div><b>問題發覺</b>從使用者遇到的困難開始</div><div><b>技術實作</b>把條件寫成可檢查規則</div><div><b>品質驗證</b>包含失敗、拒絕與例外</div><div><b>人機協作</b>檢查省下與新增的負擔</div></div></section><div class="callout warn"><b>資料分層：</b>歷史研究數值只供對照；本頁操作產生的是新的教學示例。沒有執行原 DrawIQ、MuJoCo、真機或正式臨床教學平台。</div>`;}
function drawing(t,label){return `<div class="drawing"><span class="note">${label}</span><svg viewBox="0 0 260 90" role="img" aria-label="合成零件示意圖"><rect x="45" y="20" width="150" height="42" fill="white" stroke="#173c61" stroke-width="2"/><circle cx="76" cy="41" r="10" fill="none" stroke="#173c61"/><path d="M195 41 L224 14 H250 M45 72 H195 M45 66 V79 M195 66 V79" fill="none" stroke="#173c61"/></svg><strong>${esc(t.operator)} ${esc(t.value)} ${esc(t.unit)}</strong><small>鍍層厚度 · ${esc(t.state||'present')}</small></div>`;}
function drawiq(){const s=Q.scenarios.find(x=>x.id===drawId);return head('STATION 01','修正能重用，但適用條件不能省略','先用歷史缺口示意檢查一筆建議，再加入運算子與內容狀態的檢查。數值為自製示例。')+`<div class="grid"><section class="panel"><h2>設定目標情境</h2><div class="field"><label for="draw-case">選擇案例</label><select id="draw-case">${Q.scenarios.map(x=>`<option value="${x.id}" ${x.id===drawId?'selected':''}>${x.name}</option>`).join('')}</select></div><p class="note">${s.description}</p><h3>採用的規則</h3><label class="check"><input id="check-source" type="checkbox" ${drawPolicy.source?'checked':''}>來源核准仍有效</label><label class="check"><input id="check-operator" type="checkbox" ${drawPolicy.operator?'checked':''}>比較運算子相符</label><label class="check"><input id="check-state" type="checkbox" ${drawPolicy.state?'checked':''}>目標狀態為 present</label><div class="btn-group"><button class="btn" id="draw-legacy">歷史缺口示意</button><button class="btn" id="draw-guarded">補強規則示意</button></div><button class="btn primary full" id="draw-evaluate">檢查是否提出建議</button><p class="note">這是規則摘要，不是 DrawIQ 0.4.8 完整重跑。補強規則在本教學版可執行，不代表原研究軟體已修補。</p></section><div class="stack"><section class="panel"><h2>來源經驗與目前目標</h2><div class="drawing-pair">${drawing(Q.source,'來源圖 A／原候選')}${drawing(s.target,'目標圖 B／目前候選')}</div><div class="endpoints"><span>來源核准修正：≥ 5 μm</span><span>前／後／核准三狀態保留</span><span>新目標仍需獨立覆核</span></div><div id="draw-result">${drawResult?drawResultHTML():'<div class="empty">按下「檢查」，看哪些條件真的進入判斷。</div>'}</div></section><section class="panel"><h2>把結果連到人的工作</h2><p>有來源可追查，仍要量測覆核時間、誤採納與最終關鍵欄位錯誤。少按幾次按鈕，不能單獨證明工作負荷降低。</p>${quiz('draw','哪一個結論最符合這個案例？',['只要曾經由人核准，就可自動核准新圖。','來源核准與新圖適用性需要分開確認。'],1,'有值、已採納與已核准是不同的狀態。')}</section></div></div>`;}
function drawResultHTML(){const r=drawResult;return `<div class="callout ${r.allowed?(r.uncheckedRisks.length?'warn':'success'):'bad'}" role="status"><b>${r.allowed?'產生候選建議：5 μm':r.referenceOnly?'僅提供證據參考；不複製幾何框':'停止建議，交回人工釐清'}</b><br>${r.uncheckedRisks.length?'未檢查的風險：'+r.uncheckedRisks.join('、'):(r.reasons.length?r.reasons.join('、'):'目標仍須自行覆核，未自動核准。')}</div><div class="table-scroll"><table><thead><tr><th>檢查</th><th>是否啟用</th><th>實際條件</th></tr></thead><tbody>${r.checks.map(c=>`<tr><td>${c.label}</td><td>${c.enabled?'納入判斷':'未納入'}</td><td class="status ${c.pass?'good':'bad'}">${c.pass?'符合':'不符合'}</td></tr>`).join('')}</tbody></table></div><div class="btn-group"><button class="btn teal" id="draw-adopt" ${r.allowed?'':'disabled'}>模擬採納並查看狀態</button></div>${adoption?`<div class="callout warn"><b>採納結果：已有內容，但仍待審。</b><br>內容狀態：${adoption.content_state}；審查：${adoption.review_status}；獨立核准：否。原始狀態 ${esc(adoption.original_content_state)} 與運算子 ${esc(adoption.original_operator)} 仍在活動紀錄保留。</div>`:''}`;}
function bindDraw(){function reset(){drawResult=null;adoption=null;render();} $('draw-case').onchange=e=>{drawId=e.target.value;reset();};['source','operator','state'].forEach(k=>$('check-'+k).onchange=e=>{drawPolicy[k]=e.target.checked;reset();});$('draw-legacy').onclick=()=>{drawPolicy={source:true,operator:false,state:false};reset();};$('draw-guarded').onclick=()=>{drawPolicy={source:true,operator:true,state:true};reset();};$('draw-evaluate').onclick=()=>{drawResult=Q.evaluateReuse(drawId,drawPolicy);adoption=null;session.results.drawiq=drawResult;event('evaluate_reuse',{scenario:drawId,policy:{...drawPolicy},allowed:drawResult.allowed});render();};if($('draw-adopt'))$('draw-adopt').onclick=()=>{adoption=Q.adopt(drawResult);session.results.drawiq={...drawResult,adoption};event('adopt',{...adoption});render();};}
