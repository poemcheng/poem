`;ui.planText.textContent=result.intent==='UNKNOWN'?'未對應到安全命令；不執行。請使用建議語句。':PLAN[result.intent].plan;pill(ui.voiceState,result.intent==='UNKNOWN'?'NO MATCH':source,result.intent==='UNKNOWN'?'stop':'ok')}
async function executeIntent(result){const i=result.intent;if(i==='UNKNOWN'){toast('命令不明確，已拒絕執行');return}if(i==='BLOCKED'){toast('Safety Supervisor：命令違反任務前置條件');log('Rejected command: unsafe state transition','warn');return}
 if(['FULL','DELIVERY'].includes(i)&&!PREFLIGHT_OK){toast('A 區路徑預檢失敗，禁止啟動');pill(ui.safety,'PREFLIGHT FAIL','stop');return}if(['FULL','DELIVERY','SORTING'].includes(i)&&running){toast('已有任務執行中；先暫停、重置或急停');return}if(i==='FULL')return runFull();if(i==='DELIVERY')return runDeliveryOnly();if(i==='SORTING')return runSortingOnly();if(i==='PAUSE'){if(!running){toast('目前沒有執行中的任務');return}paused=true;ui.phase.textContent='PAUSED';ui.mode.textContent='PAUSED';log('Task planner：PAUSE','warn');return}
 if(i==='RESUME'){if(!running||!paused){toast('目前沒有可恢復的暫停任務');return}paused=false;ui.phase.textContent='RUNNING';ui.mode.textContent='AUTONOMOUS';log('Task planner：RESUME','ok');return}if(i==='RESET'){resetMission(true);return}if(i==='ESTOP'){estop=true;$('estop').classList.add('active');pill(ui.safety,'E-STOP','stop');ui.mode.textContent='DRIVE POWER CUT';log('E-STOP：所有驅動暫停','err');return}if(i==='RELEASE_ESTOP'){estop=false;$('estop').classList.remove('active');pill(ui.safety,'SAFE','ok');ui.mode.textContent='AUTONOMOUS';log('E-STOP RELEASED','ok');return}if(i==='VIEW_D')return viewD();if(i==='VIEW_E')return viewE();if(i==='VIEW_ALL')return viewOverview()}
async function dispatchText(text,source='TEXT',forced=null){const r=forced?{intent:forced,confidence:1}:parseIntent(text);showIntent(text||PLAN[forced]?.label||'',r,source);if(r.confidence<.55||r.intent==='UNKNOWN')return;await executeIntent(r)}

$('exec').onclick=()=>dispatchText(ui.command.value,'TEXT');ui.command.onkeydown=e=>{if(e.key==='Enter')dispatchText(ui.command.value,'TEXT')};$('reset').onclick=()=>dispatchText('重置','BUTTON','RESET');$('estop').onclick=()=>dispatchText(estop?'解除急停':'緊急停止','BUTTON',estop?'RELEASE_ESTOP':'ESTOP');document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>dispatchText(PLAN[b.dataset.intent]?.label||b.textContent,'BUTTON',b.dataset.intent));
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const rec=new SR();rec.lang='zh-TW';rec.continuous=false;rec.interimResults=true;rec.maxAlternatives=5;let finalHandled=false;rec.onstart=()=>{finalHandled=false;pill(ui.voiceState,'LISTENING','run');$('mic').classList.add('voice-listening');ui.heard.textContent='聆聽中…'};rec.onresult=e=>{const result=e.results[e.results.length-1];let best=null;for(let i=0;i<result.length;i++){const t=result[i].transcript,r=parseIntent(t),score=(r.intent==='UNKNOWN'?0:.5)+(result[i].confidence||.5);if(!best||score>best.score)best={t,r,score}}if(best)ui.heard.textContent=best.t;if(result.isFinal&&best&&!finalHandled){finalHandled=true;showIntent(best.t,best.r,'VOICE');if(best.r.confidence>=.55&&best.r.intent!=='UNKNOWN')executeIntent(best.r);else toast('語音不明確，未執行')}};rec.onend=()=>{$('mic').classList.remove('voice-listening');if(!finalHandled)pill(ui.voiceState,'READY')};rec.onerror=e=>{pill(ui.voiceState,'VOICE ERROR','stop');ui.planText.textContent='語音辨識錯誤：'+e.error;$('mic').classList.remove('voice-listening')};$('mic').onclick=()=>{try{rec.start()}catch{}}}else{$('mic').disabled=true;ui.planText.textContent='此瀏覽器未提供 Web Speech API；仍可使用文字與按鈕。'}

// ---------- Cameras ----------
function tweenCam(p,t){camera.position.copy(p);controls.target.copy(t);controls.update()}function viewOverview(){tweenCam(new THREE.Vector3(40,28,34),new THREE.Vector3(14,0,-3))}function viewD(){tweenCam(new THREE.Vector3(30,12,8),new THREE.Vector3(22,0,-2.5))}function viewE(){tweenCam(new THREE.Vector3(31,9,10),new THREE.Vector3(25.5,.6,1.1))}$('viewOverview').onclick=viewOverview;$('viewTop').onclick=()=>tweenCam(new THREE.Vector3(14,44,-3),new THREE.Vector3(14,0,-3));$('viewD').onclick=viewD;$('viewE').onclick=viewE;

// RGB-D from tool0 / fallback E view.
const rgbR=new THREE.WebGLRenderer({canvas:$('rgb'),antialias:true}),depthR=new THREE.WebGLRenderer({canvas:$('depth')}),rgbCam=new THREE.PerspectiveCamera(60,1.8,.06,15),depthMat=new THREE.MeshDepthMaterial({depthPacking:THREE.BasicDepthPacking});
function updateCams(){const w=$('rgb').clientWidth||130,h=$('rgb').clientHeight||72;rgbR.setSize(w,h,false);depthR.setSize(w,h,false);rgbCam.aspect=w/h;rgbCam.updateProjectionMatrix();if(tool0){const p=new THREE.Vector3(),q=new THREE.Quaternion();tool0.getWorldPosition(p);tool0.getWorldQuaternion(q);rgbCam.position.copy(p);const dir=new THREE.Vector3(0,0,-1).applyQuaternion(q);rgbCam.lookAt(p.clone().add(dir.multiplyScalar(1.6)))}else{rgbCam.position.set(26.2,1.5,2.4);rgbCam.lookAt(27.4,.75,1.5)}rgbR.render(scene,rgbCam);const old=scene.overrideMaterial;scene.overrideMaterial=depthMat;depthR.render(scene,rgbCam);scene.overrideMaterial=old}

const clock=new THREE.Clock();let blink=0;function animate(){requestAnimationFrame(animate);const dt=clock.getDelta();if(!paused&&!estop){cartTime+=dt/TIME_SCALE;dynamicCarts.forEach((c,i)=>{c.position.z=predictedCartZ(i,0)})}if(dynamicCarts.length){minClearance=Math.min(...dynamicCarts.map(c=>cartDist(c,robotA.position)));ui.clearance.textContent=minClearance.toFixed(2)+' m';if(minClearance<CRASH_GAP){pill(ui.safety,'SAFETY ALERT','stop');ui.safetyLine.textContent='Minimum separation below guard threshold — motion would be aborted/retried'}else if(crossingRobot){pill(ui.safety,'CROSSING','run')}}blink+=dt;const vis=Math.sin(blink*9)>0;if(running){beaconA.visible=vis;beaconB.visible=vis}controls.update();renderer.render(scene,camera);updateCams();ui.zoneHud.textContent=`A (${robotA.position.x.toFixed(1)},${(-robotA.position.z).toFixed(1)}) · B (${robotB.position.x.toFixed(1)},${(-robotB.po