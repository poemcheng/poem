import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';
import {GLTFLoader} from 'three/addons/loaders/GLTFLoader.js';
import URDFLoader from 'urdf-loader';

const $=id=>document.getElementById(id);
const ui={
 loading:$('loading'),phase:$('phase'),clock:$('clock'),missionProgress:$('missionProgress'),
 aState:$('aState'),bState:$('bState'),orders:$('orders'),handshake:$('handshake'),aReady:$('aReady'),bReady:$('bReady'),dToken:$('dToken'),bCleared:$('bCleared'),
 score:$('score'),scoreDelivery:$('scoreDelivery'),scoreSorting:$('scoreSorting'),barDelivery:$('barDelivery'),barSorting:$('barSorting'),sA:$('sA'),sB:$('sB'),sC:$('sC'),sPick:$('sPick'),sBasket:$('sBasket'),sStack:$('sStack'),sShip:$('sShip'),penalty:$('penalty'),
 safety:$('safety'),aSpeed:$('aSpeed'),bSpeed:$('bSpeed'),clearance:$('clearance'),mode:$('mode'),safetyLine:$('safetyLine'),
 voiceState:$('voiceState'),heard:$('heard'),intent:$('intent'),planText:$('planText'),visionState:$('visionState'),visionText:$('visionText'),
 log:$('log'),command:$('command'),toast:$('toast'),zoneHud:$('zoneHud')
};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function pill(el,text,cls='idle'){el.textContent=text;el.className='pill '+cls}
function log(msg,cls=''){const d=document.createElement('div');d.className=cls;d.textContent=new Date().toLocaleTimeString('zh-TW',{hour12:false})+'  '+msg;ui.log.prepend(d)}
function toast(msg){ui.toast.textContent=msg;ui.toast.classList.add('show');setTimeout(()=>ui.toast.classList.remove('show'),1900)}

const ORDERS=[{id:1,D:1,E:4,F:0,G:0},{id:2,D:2,E:1,F:2,G:0},{id:3,D:0,E:3,F:1,G:0},{id:4,D:0,E:0,F:2,G:1},{id:5,D:1,E:1,F:0,G:2},{id:6,D:0,E:2,F:2,G:0}];
const SKU={D:'D1',E:'E1',F:'F1',G:'G1'};
const SKU_NAME={D1:'華淨 3D 醫療口罩 50入／盒',E1:'家樂氏 COCO格格脆 170g／盒',F1:'美琪 香皂 85g × 6塊',G1:'DARLIE 好來 全亮白清新薄荷牙膏 140g × 2入'};
ORDERS.forEach(o=>{const e=document.createElement('div');e.className='order';e.id='order-'+o.id;e.innerHTML=`<b>Basket-${o.id}</b><small>D${o.D} · E${o.E} · F${o.F} · G${o.G}</small>`;ui.orders.appendChild(e)});

const score={A:0,B:0,C:0,pick:0,basket:0,stack:0,ship:0,penalty:0};
const dScore=()=>score.A+score.B+score.C; const sScore=()=>score.pick+score.basket+score.stack+score.ship;
function updateScore(){const d=dScore(),s=sScore(),t=Math.max(0,d+s+score.penalty);ui.score.textContent=t;ui.scoreDelivery.textContent=`${d} / 68`;ui.scoreSorting.textContent=`${s} / 65`;ui.barDelivery.style.width=d/68*100+'%';ui.barSorting.style.width=s/65*100+'%';ui.sA.textContent=`${score.A}/36`;ui.sB.textContent=`${score.B}/20`;ui.sC.textContent=`${score.C}/12`;ui.sPick.textContent=`${score.pick}/25`;ui.sBasket.textContent=`${score.basket}/25`;ui.sStack.textContent=`${score.stack}/12`;ui.sShip.textContent=`${score.ship}/3`;ui.penalty.textContent=score.penalty.toFixed(1);if(running)ui.missionProgress.style.width=Math.min(99,t/133*100)+'%'}
function addScore(k,v,why){score[k]+=v;updateScore();if(why)log(`${why} ${v>0?'+':''}${v}`,'ok')}

// ---------- Three.js ----------
const scene=new THREE.Scene();scene.background=new THREE.Color(0x08121a);scene.fog=new THREE.Fog(0x08121a,48,95);
const camera=new THREE.PerspectiveCamera(42,innerWidth/innerHeight,.05,180);camera.position.set(40,28,34);
const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;document.body.prepend(renderer.domElement);
const controls=new OrbitControls(camera,renderer.domElement);controls.target.set(14,0,-3);controls.enableDamping=true;controls.maxPolarAngle=Math.PI/2.02;controls.minDistance=5;controls.maxDistance=80;
scene.add(new THREE.HemisphereLight(0xe8f5ff,0x262a2e,1.55));const sun=new THREE.DirectionalLight(0xfff5e5,2.3);sun.position.set(9,32,18);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-45;sun.shadow.camera.right=45;sun.shadow.camera.top=35;sun.shadow.camera.bottom=-35;scene.add(sun);

const loader=new GLTFLoader();

// ---------- Source-grounded procedural reconstruction (TRC2026 ZIP/manual dimensions) ----------
const MAT={
 concrete:new THREE.MeshStandardMaterial({color:0x777d80,roughness:.92,metalness:.04}),
 concrete2:new THREE.MeshStandardMaterial({color:0x686f72,roughness:.9,metalness:.06}),
 wall:new THREE.MeshStandardMaterial({color:0x744319,roughness:.78,metalness:.02}),
 steel:new THREE.MeshStandardMaterial({color:0x9aa3a7,roughness:.34,metalness:.72}),
 dark:new THREE.MeshStandardMaterial({color:0x20292e,roughness:.48,metalness:.55}),
 wood:new THREE.MeshStandardMaterial({color:0xb76b27,roughness:.82,metalness:.02}),
 orange:new THREE.MeshStandardMaterial({color:0xe48324,roughness:.55,metalness:.18}),
 teal:new THREE.MeshStandardMaterial({color:0x0d4e55,roughness:.58,metalness:.30}),
 black:new THREE.MeshStandardMaterial({color:0x111518,roughness:.70,metalness:.25}),
 yellow:new THREE.MeshStandardMaterial({color:0xf1c743,roughness:.7,metalness:.06})
};
function boxMesh(w,h,d,mat,x=0,y=h/2,z=0,parent=scene){
 const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);return m
}
function floorBox(w,d,x,z,mat=MAT.concrete){return boxMesh(w,.08,d,mat,x,-.04,z)}
function strip(w,d,x,z,color=0x15191b,y=.012){
 const m=new THREE.Mesh(new THREE.BoxGeometry(w,.018,d),new THREE.MeshStandardMaterial({color,roughness:.75}));m.position.set(x,y,z);scene.add(m);return m
}
function borderRect(w,d,x,z,color=0x101316){
 strip(w,.05,x,z-d/2,color);strip(w,.05,x,z+d/2,color);strip(.05,d,x-w/2,z,color);strip(.05,d