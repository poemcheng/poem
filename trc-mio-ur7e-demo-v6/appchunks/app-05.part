(60,1.8,.06,15),depthMat=new THREE.MeshDepthMaterial({depthPacking:THREE.BasicDepthPacking});
function updateCams(){const w=$('rgb').clientWidth||130,h=$('rgb').clientHeight||72;rgbR.setSize(w,h,false);depthR.setSize(w,h,false);rgbCam.aspect=w/h;rgbCam.updateProjectionMatrix();if(tool0){const p=new THREE.Vector3(),q=new THREE.Quaternion();tool0.getWorldPosition(p);tool0.getWorldQuaternion(q);rgbCam.position.copy(p);const dir=new THREE.Vector3(0,0,-1).applyQuaternion(q);rgbCam.lookAt(p.clone().add(dir.multiplyScalar(1.6)))}else{rgbCam.position.set(26.2,1.5,2.4);rgbCam.lookAt(27.4,.75,1.5)}rgbR.render(scene,rgbCam);const old=scene.overrideMaterial;scene.overrideMaterial=depthMat;depthR.render(scene,rgbCam);scene.overrideMaterial=old}

const clock=new THREE.Clock();let blink=0;function animate(){requestAnimationFrame(animate);const dt=clock.getDelta();if(!paused&&!estop){cartTime+=dt/TIME_SCALE;const z0=-5.283,z1=-9.68,L=z0-z1,period=2*L/.8;dynamicCarts.forEach((c,i)=>{const t=(cartTime+i*period/3)%period,d=.8*t;c.position.z=d<=L?z0-d:z1+(d-L)})}if(dynamicCarts.length){minClearance=Math.min(...dynamicCarts.map(c=>cartDist(c,robotA.position)));ui.clearance.textContent=minClearance.toFixed(2)+' m';if(minClearance<CRASH_GAP){pill(ui.safety,'SAFETY ALERT','stop');ui.safetyLine.textContent='Minimum separation below guard threshold — motion would be aborted/retried'}else if(crossingRobot){pill(ui.safety,'CROSSING','run')}}blink+=dt;const vis=Math.sin(blink*9)>0;if(running){beaconA.visible=vis;beaconB.visible=vis}controls.update();renderer.render(scene,camera);updateCams();ui.zoneHud.textContent=`A (${robotA.position.x.toFixed(1)},${(-robotA.position.z).toFixed(1)}) · B (${robotB.position.x.toFixed(1)},${(-robotB.position.z).toFixed(1)}) · D token=${dOwner||'FREE'}`}
animate();addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
updateScore();viewOverview();ui.loading.classList.add('hide');log('V6：ZIP source scene + safety supervisor + deterministic task planner ready','ok');
