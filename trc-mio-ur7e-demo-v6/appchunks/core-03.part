try{const mb=await loader.loadAsync(window.TRCDemoAssets.MIO_GLB_URI);mb.scene.scale.setScalar(.72);mb.scene.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});baseHost.add(mb.scene)}catch(e){log('MIO GLB 載入失敗：'+e.message,'err')}
const armMount=new THREE.Group();armMount.position.set(0,.69,0);robotB.add(armMount);let urdfRobot=null,tool0=null;
try{if(window.TRCDemoAssets?.UR7E_URDF){const u=new URDFLoader();urdfRobot=u.parse(window.TRCDemoAssets.UR7E_URDF);urdfRobot.rotation.x=-Math.PI/2;urdfRobot.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});armMount.add(urdfRobot);tool0=urdfRobot.links?.tool0||null;log('UR7e 官方 URDF 已載入','ok')}}catch(e){log('UR7e URDF 載入錯誤：'+e.message,'err')}
