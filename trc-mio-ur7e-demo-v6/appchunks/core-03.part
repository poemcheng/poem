const PRODUCT_POS={"D":[[27.345,2.0645,0.748],[27.535,2.0645,0.748],[27.725,2.0645,0.748],[27.345,1.9875,0.748]],"E":[[27.345,1.7595,0.748],[27.535,1.7595,0.748],[27.725,1.7595,0.748],[27.345,1.6825,0.748],[27.535,1.6825,0.748],[27.725,1.6825,0.748],[27.345,1.6055,0.748],[27.535,1.6055,0.748],[27.725,1.6055,0.748],[27.345,1.7595,0.878],[27.535,1.7595,0.878]],"F":[[27.345,1.4545,0.748],[27.535,1.4545,0.748],[27.725,1.4545,0.748],[27.345,1.3775,0.748],[27.535,1.3775,0.748],[27.725,1.3775,0.748],[27.345,1.3005,0.748]],"G":[[27.405,1.1495,0.748],[27.665,1.1495,0.748],[27.405,1.0725,0.748]]};
const PROD_SPEC={
 D:{size:[.19,.10,.09],color:0xe8f1ef},E:{size:[.18,.24,.065],color:0xd9a72c},F:{size:[.15,.075,.065],color:0xe28ab3},G:{size:[.20,.055,.055],color:0x2364a9}
};
function createProduct(cat,pos){
 const s=PROD_SPEC[cat],g=new THREE.Group(),m=new THREE.MeshStandardMaterial({color:s.color,roughness:.62,metalness:.05});
 boxMesh(s.size[0],s.size[1],s.size[2],m,0,s.size[1]/2,0,g);g.position.set(pos[0],.755,pos[1]);g.rotation.y=(Math.sin(pos[0]*12+pos[1]*5)*.55);g.userData.taken=false;g.userData.cat=cat;scene.add(g);return g
}
const sourceItems={D:[],E:[],F:[],G:[]};for(const cat of ['D','E','F','G'])PRODUCT_POS[cat].forEach(p=>sourceItems[cat].push(createProduct(cat,p)));

// Robot A — realistic automatic-forklift proxy built to manual role, not a toy block.
function createAGF(){
 const g=new THREE.Group();boxMesh(.82,.32,1.20,new THREE.MeshStandardMaterial({color:0x202a2d,roughness:.42,metalness:.62}),0,.23,0,g);
 boxMesh(.74,.38,.70,new THREE.MeshStandardMaterial({color:0xd07721,roughness:.48,metalness:.35}),0,.53,-.10,g);
 for(const sx of [-.34,.34])for(const sz of [-.39,.39]){const w=new THREE.Mesh(new THREE.CylinderGeometry(.14,.14,.09,18),MAT.black);w.rotation.z=Math.PI/2;w.position.set(sx,.14,sz);g.add(w)}
 // mast and forks at +Z (forward)
 for(const sx of [-.27,.27])boxMesh(.09,1.35,.09,MAT.dark,sx,.93,.50,g);
 boxMesh(.64,.09,.09,MAT.dark,0,1.53,.50,g);
 for(const sx of [-.19,.19])boxMesh(.09,.065,.90,MAT.steel,sx,.13,1.00,g);
 boxMesh(.30,.16,.08,new THREE.MeshStandardMaterial({color:0x54b95e,emissive:0x1c6c2b,emissiveIntensity:.5}),0,.30,-.62,g);
 return g
}
const robotA=createAGF();scene.add(robotA);robotA.position.set(13.10,0,-.93);

