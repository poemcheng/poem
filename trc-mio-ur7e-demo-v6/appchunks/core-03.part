23])boxMesh(.045,.71,.045,MAT.steel,sx,.355,sz,g);
 g.position.set(x,0,z);g.rotation.y=rot;scene.add(g);return g
}
for(const x of [23.98,25.20,26.42])createTable(x,.465);
createTable(27.535,1.53,Math.PI/2);

// baskets, exact 0.62×0.43×0.24 m
function createBasket(id,x,z){
 const g=new THREE.Group();const w=.62,d=.43,h=.24;boxMesh(w,.035,d,MAT.teal,0,.018,0,g);
 for(const sx of [-w/2,w/2])for(const sz of [-d/2,d/2])boxMesh(.026,h,.026,MAT.teal,sx,h/2,sz,g);
 for(let yy=.065;yy<h;yy+=.065){boxMesh(.025,.022,d,MAT.teal,-w/2,yy,0,g);boxMesh(.025,.022,d,MAT.teal,w/2,yy,0,g);boxMesh(w,.022,.025,MAT.teal,0,yy,-d/2,g);boxMesh(w,.022,.025,MAT.teal,0,yy,d/2,g)}
 qrPlane(`Basket-${id}`,.095,g,0,.12,-d/2-.006,0);g.position.set(x,.74,z);g.userData.id=id;scene.add(g);return g
}
const baskets=[23.65,24.26,24.87,25.48,26.09,26.70].map((x,i)=>createBasket(i+1,x,.465));

