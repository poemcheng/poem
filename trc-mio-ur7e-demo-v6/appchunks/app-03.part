new THREE.Vector3(27.10,0,-5.50),new THREE.Vector3(23.20,0,-3.65)],.88,token,ui.aSpeed,'C → D 開放通道');await rotateTo(robotA,Math.PI/2,token);setStep('a3','done');setStep('a4','active');aAtD=true;ui.aReady.textContent='YES';pill(ui.aState,'PARKED @ D','run');setSafety('SAFE','ok','Robot A 已停靠 D；驅動保持，等待 B 逐籃移載');log('Robot A：D safe dock locked','ok');if(stopAtD){beaconA.visible=false;return}while(!handshakeDone){await waitRun(token);await sleep(70)}while(!bClearedD){await waitRun(token);await sleep(70)}setStep('a4','done');setStep('a5','active');await acquireD('A_SHIP',token);await follow(robotA,[new THREE.Vector3(20.0,0,-3.60),new THREE.Vector3(19.75,0,-1.25)],.72,token,ui.aSpeed,'Robot A：B 已清空 D → 出貨區');addScore('ship',3,'出貨棧板完成出貨');await follow(robotA,[new THREE.Vector3(24.6,0,-1.3),new THREE.Vector3(27.05,0,-4.10)],.82,token,ui.aSpeed,'Robot A：D 終點');releaseD('A_SHIP');setStep('a5','done');pill(ui.aState,'FINISHED','ok');beaconA.visible=false}

function localItemSlot(n){return new THREE.Vector3((n%3-1)*.12,.26+Math.floor(n/3)*.075,(n%2?-.055:.055))}
async function pickOne(cat,basket,slot,token){const item=sourceItems[cat][srcIndex[cat]++];if(!item)throw new Error(`source depleted ${cat}`);await follow(robotB,[new THREE.Vector3(26.65,0,1.55)],.65,token,ui.bSpeed,`Robot B：物料區 ${cat} dock`);pill(ui.visionState,'DETECTED','ok');ui.visionText.textContent=`QR=${cat} · ${SKU[cat]} · ${SKU_NAME[SKU[cat]]} · 6D pose OK`;await armPose('scan',token,230);await armPose('pick',token,290);scene.attach(item);await moveTo(item,new THREE.Vector3(robotB.position.x,.95,robotB.position.z-.15),1.35,token,null);robotB.attach(item);item.position.set(.18,.96,-.12);const dockX=clamp(basket.position.x,23.65,26.7);await follow(robotB,[new THREE.Vector3(dockX,0,1.25)],.62,token,ui.bSpeed,`Robot B：Basket-${basket.userData.id} dock`);await armPose('basket',token,250);basket.attach(item);item.position.copy(localItemSlot(slot));item.rotation.set(0,.12*(slot%3),0);item.userData.taken=true;addScore('pick',1,`${SKU[cat]} 取出`);addScore('basket',1,`${SKU[cat]} 放入 Basket-${basket.userData.id}`);await armPose('carry',token,210)}
async function sortAllBaskets(token){pill(ui.bState,'SORTING @ E','run');srcIndex={D:0,E:0,F:0,G:0};for(const o of ORDERS){orderState(o.id,'active');const basket=baskets[o.id-1];pill(ui.visionState,'QR BASKET','run');ui.visionText.textContent=`Basket-${o.id} → 訂單 D${o.D} E${o.E} F${o.F} G${o.G}`;await sleep(120);let slot=0;for(const cat of ['D','E','F','G'])for(let k=0;k<o[cat];k++)await pickOne(cat,basket,slot++,token);orderState(o.id,'done')}bSortDone=true;pill(ui.bState,'6 BASKETS READY','ok');pill(ui.visionState,'SORT COMPLETE','ok');log('Robot B：E 區 6 籃分揀完成；等待 A@D','ok')}
async function transferBasketToD(basket,i,token){await acquireD('B_TRANSFER',token);const bx=basket.position.x;await follow(robotB,[new THREE.Vector3(clamp(bx,23.65,26.70),0,1.25)],.7,token,ui.bSpeed,`Robot B：取 Basket-${basket.userData.id}`);await armPose('basket',token,230);scene.attach(basket);await moveTo(basket,new THREE.Vector3(robotB.position.x,.78,robotB.position.z-.10),1.25,token,null);robotB.attach(basket);basket.position.set(0,.70,-.18);await follow(robotB,[new THREE.Vector3(22.00,0,.42),new THREE.Vector3(22.00,0,-2.62)],.88,token,ui.bSpeed,`Robot B：Basket-${basket.userData.id} → D transfer lane`);await armPose('basket',token,240);pallet.attach(basket);const layer=Math.floor(i/2),side=i%2;basket.position.set(side?.23:-.23,.22+layer*.24,0);basket.rotation.set(0,Math.PI/2,0);addScore('stack',2,`Basket-${basket.userData.id} 堆疊 Layer ${layer+1}`);basketsAtD++;ui.bReady.textContent=basketsAtD+'/6';await follow(robotB,[new THREE.Vector3(22.00,0,.42),new THREE.Vector3(24.2,0,1.35)],.88,token,ui.bSpeed,'Robot B：退出 D transfer lane');releaseD('B_TRANSFER')}
async function maybeHandshake(token){if(aAtD&&basketsAtD===6&&!handshakeDone){handshakeDone=true;pill(ui.handshake,'SYNC','run');ui.planText.textContent='A_READY ∧ B_STACK_6 → HANDSHAKE → B_CLEAR_D → A_SHIP';log('A/B handshake：A_READY + B_STACK_COMPLETE','ok');await sleep(350);pill(ui.handshake,'ACK','ok');toast('A/B 交握完成')}}
async function runRobotB(token,{standalone=false}={}){pill(ui.bState,'RUNNING','run');beaconB.visible=true;await sortAllBaskets(token);if(standalone){await follow(robotB,[new THREE.Vector3(21.90,0,1.53)],.8,token,ui.bSpeed,'Robot B：E 終點');pill(ui.bState,'FINISHED','ok');beaconB.visible=false;return}while(!aAtD){await waitRun(token);pill(ui.bState,'WAIT A@D','run');await sleep(70)}for(let i=0;i<baskets.length;i++)await transferBasketToD(baskets[i],i,token);await maybeHandshake(token);await follow(robotB,[new THREE.Vector3(22.0,0,.42),new THREE.Vector3(21.90,0,1.53)],.82,token,ui.bSpeed,'Robot B：交握後清空 D → E 終點');bClearedD=true;ui.bCleared.textContent='YES';pill(ui.bState,'FINISHED','ok');beaconB.visible=false;log('Robot B：D zone cleared，授權 Robot A 出貨','ok')}

function startTimer(){stopTimer();let r=1200;timerHandle=setInterval(()=>{r--;ui.clock.textContent=`${String(Math.floor(r/60)).padStart(2,'0')}:${String(r%60).padStart(2,'0')}`;if(r<=0){stopTimer();estop=true;ui.phase.textContent='TIMEOUT';pill(ui.safety,'STOP','stop');log('20 分鐘時間到：任務停止','err')}},1000)}function stopTimer(){if(timerHandle)clearInterval(timerHandle);timerHandle=null}
async function runFull(){if(running){toast('已有任務執行中');return}resetMission(false);running=true;const token=missionEpoch;ui.phase.textContent='PREP';ui.planText.textContent='PREP → parallel(A delivery, B sorting) → A@D → B transfer×6 → handshake → B clear D → A ship';log('5 分鐘準備狀態確認（demo 加速呈現）','ok');await sleep(300);if(token!==missionEpoch)return;ui.phase.textContent='RUNNING';startTimer();beaconA.visible=beaconB.visible=true;try{await Promise.all([runRobotA(token),runRobotB(token)]);ensureToken(token);ui.phase.textContent='COMPLETE';ui.missionProgress.style.width='100%';toast(`Demo 完成 · ${ui.score.textContent}/133`);log('安全監督式完整流程完成','ok')}catch(e){if(!(e instanceof Cancelled)){console.error(e);ui.phase.textContent='FAULT';log('任務錯誤：'+e.message,'err')}}finally{if(token===missionEpoch){running=false;stopTimer()}}}
async function runDeliveryOnly(){if(running){toast('已有任務執行中');return}resetMission(false);running=true;const token=missionEpoch;ui.phase.textContent='DELIVERY DEMO';startTimer();try{await runRobotA(token,{stopAtD:true});ui.phase.textContent='DELIVERY DONE'}catch(e){if(!(e instanceof Cancelled))log(e.message,'err')}finally{if(token===missionEpoch){running=false;stopTimer()}}}
async function runSortingOnly(){if(running){toast('已有任務執行中');return}resetMission(false);running=true;const token=missionEpoch;ui.phase.textContent='SORTING DEMO';startTimer();try{await runRobotB(token,{standalone:true});ui.phase.textContent='SORTING DONE'}catch(e){if(!(e instanceof Cancelled))log(e.message,'err')}finally{if(token===missionEpoch){running=false;stopTimer()}}}

function resetScore(){Object.keys(score).forEach(k=>score[k]=0);updateScore();clearSteps();ORDERS.forEach(o=>orderState(o.id,''))}
function restoreSnaps