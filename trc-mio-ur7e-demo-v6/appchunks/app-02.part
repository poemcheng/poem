e_G1_${i}`))};
Object.values(sourceItems).flat().filter(Boolean).forEach(o=>o.userData.taken=false);
baskets.forEach((b,i)=>b.userData.id=i+1);

function snapshot(o){return {o,parent:o.parent,pos:o.position.clone(),quat:o.quaternion.clone(),scale:o.scale.clone(),visible:o.visible}}
const snapshots=[...baskets.map(snapshot),...Object.values(sourceItems).flat().filter(Boolean).map(snapshot),snapshot(pallet)];
const initialA=robotA.position.clone(),initialARot=robotA.quaternion.clone(),initialB=robotB.position.clone(),initialBRot=robotB.quaternion.clone();

function beacon(parent,y){const g=new THREE.Group();const m=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.09,16),new THREE.MeshStandardMaterial({color:0xffb31a,emissive:0xff7b00,emissiveIntensity:2.5}));m.position.y=y;g.add(m);parent.add(g);g.visible=false;return g}const beaconA=beacon(robotA,1.55),beaconB=beacon(robotB,1.66);

// ---------- Mission & Safety Supervisor ----------
const TIME_SCALE=.20; // physical dynamics and robot trajectories are accelerated equally for a short demo.
let running=false,paused=false,estop=false,missionEpoch=0,timerHandle=null,cartTime=0;
let aAtD=false,bSortDone=false,basketsAtD=0,handshakeDone=false,bClearedD=false,dOwner=null,srcIndex={D:0,E:0,F:0,G:0};
let crossingRobot=false,minClearance=99;
class Cancelled extends Error{constructor(){super('mission cancelled')}} class SafetyRetry extends Error{constructor(){super('safety retry')}}
function ensureToken(token){if(token!==missionEpoch)throw new Cancelled()}
async function waitRun(token){while(true){ensureToken(token);if(!paused&&!estop)return;await sleep(60)}}
function setStep(id,state){document.querySelectorAll('.steps li').forEach(li=>{if(li.dataset.step===id){li.classList.remove('active','done');if(state)li.classList.add(state)}})}function clearSteps(){document.querySelectorAll('.steps li').forEach(li=>li.classList.remove('active','done'))}function orderState(i,state){const e=$('order-'+i);e.classList.remove('active','done');if(state)e.classList.add(state)}
function setSafety(text,cls='ok',detail=''){pill(ui.safety,text,cls);ui.safetyLine.textContent=detail||text}
function requestD(owner){if(dOwner&&dOwner!==owner)return false;dOwner=owner;ui.dToken.textContent=owner;return true}function releaseD(owner){if(dOwner===owner){dOwner=null;ui.dToken.textContent='FREE'}}
async function acquireD(owner,token){while(!requestD(owner)){await waitRun(token);await sleep(70)}}

function moveTo(obj,to,speed,token,speedEl,label='',guard=null){return new Promise((resolve,reject)=>{const from=obj.position.clone(),dist=from.distanceTo(to),dur=Math.max(140,dist/Math.max(speed,.1)*1000*TIME_SCALE);let st=performance.now(),last=st;if(label)log(label);function step(now){try{ensureToken(token)}catch(e){reject(e);return}if(paused||estop){st+=now-last;last=now;requestAnimationFrame(step);return}last=now;const u=clamp((now-st)/dur,0,1),e=u*u*(3-2*u);const cand=new THREE.Vector3().lerpVectors(from,to,e);if(guard&&!guard(cand)){obj.position.copy(from);if(speedEl)speedEl.textContent='0.00 m/s';reject(new SafetyRetry());return}obj.position.copy(cand);const dx=to.x-from.x,dz=to.z-from.z;if(Math.hypot(dx,dz)>.01)obj.rotation.y=Math.atan2(dx,dz);if(speedEl)speedEl.textContent=Math.min(1.95,speed).toFixed(2)+' m/s';if(u<1)requestAnimationFrame(step);else{if(speedEl)speedEl.textContent='0.00 m/s';resolve()}}requestAnimationFrame(step)})}
async function follow(obj,pts,speed,token,el,label=''){if(label)log(label);for(const p of pts){await waitRun(token);await moveTo(obj,p,speed,token,el)}}
async function rotateTo(obj,yaw,token,ms=260){const start=obj.rotation.y,d=((yaw-start+Math.PI*3)%(Math.PI*2))-Math.PI;const t0=performance.now();while(true){await waitRun(token);const u=clamp((performance.now()-t0)/ms,0,1);obj.rotation.y=start+d*(u*u*(3-2*u));if(u>=1)break;await sleep(16)}}
async function armPose(name,token,ms=420){if(!urdfRobot)return;const tgt=JOINT_POSE[name],start=rosJoint.map(n=>urdfRobot.joints?.[n]?.angle||0),t0=performance.now();pill(ui.bState,'MOVEIT2 '+name.toUpperCase(),'run');while(true){await waitRun(token);const u=clamp((performance.now()-t0)/ms,0,1),e=u*u*(3-2*u);rosJoint.forEach((n,i)=>urdfRobot.joints?.[n]?.setJointValue(THREE.MathUtils.lerp(start[i],THREE.MathUtils.degToRad(tgt[i]),e)));if(u>=1)break;await sleep(16)}}

const A_SAFE=[new THREE.Vector3(13.12,0,-3.18),new THREE.Vector3(12.00,0,-3.34),new THREE.Vector3(11.28,0,-4.06),new THREE.Vector3(6.64,0,-4.06),new THREE.Vector3(5.68,0,-3.10),new THREE.Vector3(4.00,0,-3.10),new THREE.Vector3(.88,0,-4.22)];
const C_TRACK_X=[18.087,21.054,24.021],CROSS_Z=-8.55,SAFE_GAP=1.45,CRASH_GAP=.78;
function cartDist(cart,p){return Math.hypot(p.x-cart.position.x,p.z-cart.position.z)}
async function waitForCWindow(cart,idx,token){setSafety('GAP CHECK','run',`C${idx}：預測動態障礙安全時窗`);while(true){await waitRun(token);const dz=Math.abs(cart.position.z-CROSS_Z);if(dz>SAFE_GAP){setSafety('SAFE WINDOW','ok',`C${idx}：clearance ${dz.toFixed(2)} m，授權穿越`);return}ui.clearance.textContent=dz.toFixed(2)+' m';await sleep(45)}}
async function crossC(cart,idx,token){const x=C_TRACK_X[idx-1],pre=new THREE.Vector3(x-.96,0,CROSS_Z),post=new THREE.Vector3(x+.96,0,CROSS_Z);await moveTo(robotA,pre,.9,token,ui.aSpeed,`Robot A：C${idx} safety gate`);for(let attempt=1;attempt<=3;attempt++){await waitForCWindow(cart,idx,token);crossingRobot=true;try{await moveTo(robotA,post,1.25,token,ui.aSpeed,`C${idx} 授權穿越`,cand=>cartDist(cart,cand)>CRASH_GAP);crossingRobot=false;setSafety('SAFE','ok',`C${idx} 穿越完成，無接觸`);addScore('C',4,`C${idx} 無碰撞`);return}catch(e){crossingRobot=false;if(!(e instanceof SafetyRetry))throw e;setSafety('REPLAN','run',`C${idx} 動態障礙進入保護距離，回退重試`);log(`C${idx} crossing aborted before collision · retry ${attempt}`,'warn');await sleep(120)}}throw new Error(`C${idx} safety window unavailable`)}

async function runRobotA(token,{stopAtD=false}={}){pill(ui.aState,'RUNNING','run');beaconA.visible=true;setStep('a0','active');await follow(robotA,[new THREE.Vector3(13.18,0,-2.15),new THREE.Vector3(13.20,0,-2.55)],.8,token,ui.aSpeed,'Robot A：A 起點 → 空棧板');robotA.attach(pallet);pallet.position.set(0,.18,-1.10);pallet.rotation.set(0,0,0);addScore('A',4,'棧板完全移出存放區');setStep('a0','done');setStep('a1','active');await follow(robotA,A_SAFE,.86,token,ui.aSpeed,'A 區：collision-certified 130 cm path');addScore('A',20,'130 cm 窄道完全通過');addScore('A',4,'A1 完全通過');addScore('A',4,'A2 完全通過');addScore('A',4,'A3 完全通過');setStep('a1','done');setStep('a2','active');await follow(robotA,[new THREE.Vector3(.88,0,-5.65),new THREE.Vector3(4.15,0,-9.15),new THREE.Vector3(5.77,.211,-9.15),new THREE.Vector3(8.27,.211,-9.15),new THREE.Vector3(9.82,0,-9.15),new THREE.Vector3(13.25,0,-9.05),new THREE.Vector3(15.15,0,-8.55)],.82,token,ui.aSpeed,'B 區：8° 負重坡道');addScore('B',10,'8° 上坡完成');addScore('B',10,'8° 下坡完成');setStep('a2','done');setStep('a3','active');for(let i=0;i<3;i++)await crossC(dynamicCarts[i],i+1,token);await follow(robotA,[new THREE.Vector3(26.95,0,-8.55),new THREE.Vector3(26.95,0,-5.70),new THREE.Vector3(24.8,0,-3.25)],.9,token,ui.aSpeed,'C → D：經右側開口安全進站');setStep('a3','done');setStep('a4','active');aAtD=true;ui.aReady.textContent='YES';pill(ui.aState,'PARKED @ D','run');setSafety('D INTERLOCK','run','Robot A 已停妥，等待 B 完成六籃及取得 D-zone token');if(stopAtD)return;while(!handshakeDone){await waitRun(token);await sleep(70)}setStep('a4','done');while(!bClearedD){await waitRun(token);await sleep(70)}await acquireD('A_SHIP',token);setStep('a5','active');await follow(robotA,[new THREE.Vector3(23.1,0,-2.15),new THREE.Vector3(22.55,0,-.85)],.75,token,ui.aSpeed,'Robot A：B 已清空 D，開始出貨');addScore('ship',3,'出貨棧板移至出貨區');await follow(robotA,[new THREE.Vector3(25.5,0,-4.2),new THREE.Vector3(27.0,0,-4.0)],.9,token,ui.aSpeed,'Robot A：前往 D 終點');releaseD('A_SHIP');setStep('a5','done');pill(ui.aState,'FINISHED','ok');beaconA.visible=false}
