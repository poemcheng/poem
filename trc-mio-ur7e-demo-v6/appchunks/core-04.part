rcIndex={D:0,E:0,F:0,G:0};
let crossingRobot=false,minClearance=99;
class Cancelled extends Error{constructor(){super('mission cancelled')}} class SafetyRetry extends Error{constructor(){super('safety retry')}}
function ensureToken(token){if(token!==missionEpoch)throw new Cancelled()}
async function waitRun(token){while(true){ensureToken(token);if(!paused&&!estop)return;await sleep(60)}}
function setStep(id,state){document.querySelectorAll('.steps li').forEach(li=>{if(li.dataset.step===id){li.classList.remove('active','done');if(state)li.classList.add(state)}})}function clearSteps(){document.querySelectorAll('.steps li').forEach(li=>li.classList.remove('active','done'))}function orderState(i,state){const e=$('order-'+i);e.classList.remove('active','done');if(state)e.classList.add(state)}
function setSafety(text,cls='ok',detail=''){pill(ui.safety,text,cls);ui.safetyLine.textContent=detail||text}
function requestD(owner){if(dOwner&&dOwner!==owner)return false;dOwner=owner;ui.dToken.textContent=owner;return true}function releaseD(owner){if(dOwner===owner){dOwner=null;ui.dToken.textContent='FREE'}}
async function acquireD(owner,token){while(!requestD(owner)){await waitRun(token);await sleep(70)}}

function moveTo(obj,to,speed,token,speedEl,label='',guard=null){return new Promise((resolve,reject)=>{const from=obj.position.clone(),dist=from.distanceTo(to),dur=Math.max(140,dist/Math.max(speed,.1)*1000*TIME_SCALE);let st=performance.now(),last=st;if(label)log(label);function step(now){try{ensureToken(token)}catch(e){reject(e);return}if(paused||estop){st+=now-last;last=now;requestAnimationFrame(step);return}last=now;const u=clamp((now-st)/dur,0,1),e=u*u*(3-2*u);const cand=new THREE.Vector3().lerpVectors(from,to,e);if(guard&&!guard(cand)){obj.position.copy(from);if(speedEl)speedEl.textContent='0.00 m/s';reject(new SafetyRetry());return}obj.position.copy(cand);const dx=to.x-from.x,dz=to.z-from.z;if(Math.hypot(dx,dz)>.01)obj.rotation.y=Math.atan2(dx,dz);if(speedEl)speedEl.textContent=Math.min(1.95,speed).toFixed(2)+' m/s';if(u<1)requestAnimationFrame(step);else{if(speedEl)speedEl.textContent='0.00 m/s';resolve()}}requestAnimationFrame(step)})}
async function follow(obj,pts,speed,token,el,label='',guard=null){if(label)log(label);for(const p of pts){await waitRun(token);await moveTo(obj,p,speed,token,el,'',guard)}}
async function rotateTo(obj,yaw,token,ms=260){const start=obj.rotation.y,d=((yaw-start+Math.PI*3)%(Math.PI*2))-Math.PI;const t0=performance.now();while(true){await waitRun(token);const u=clamp((performance.now()-t0)/ms,0,1);obj.rotation.y=start+d*(u*u*(3-2*u));if(u>=1)break;await sleep(16)}}
async function armPose(name,token,ms=420){if(!urdfRobot)return;const tgt=JOINT_POSE[name],start=rosJoint.map(n=>urdfRobot.joints?.[n]?.angle||0),t0=performance.now();pill(ui.bState,'MOVEIT2 '+name.toUpperCase(),'run');while(true){await waitRun(token);const u=clamp((performance.now()-t0)/ms,0,1),e=u*u*(3-2*u);rosJoint.forEach((n,i)=>urdfRobot.joints?.[n]?.setJointValue(THREE.MathUtils.lerp(start[i],THREE.MathUtils.degToRad(tgt[i]),e)));if(u>=1)break;await sleep(16)}}

const A_SAFE=[new THREE.Vector3(13.10,0,-3.19),new THREE.Vector3(11.25,0,-2.59),new THREE.Vector3(8.45,0,-2.59),new THREE.Vector3(7.95,0,-3.14),new THREE.Vector3(7.90,0,-3.19),new THREE.Vector3(3.55,0,-3.14),new THREE.Vector3(3.50,0,-3.19),new THREE.Vector3(.90,0,-4.24)];
function clearAStatic(p){if(p.x<.56||p.x>13.48||p.z<-4.38||p.z>-.56)return false;for(const r of STATIC_A_RECTS){if(Math.abs(p.x-r.x)<.85&&Math.abs(p.z-r.z)<.70)return false}return true}
const C_TRACK_X=[18.087,21.054,24.021],CROSS_Z=-8.55,SAFE_GAP=2.05,CRASH_GAP=.82;
const C_Z0=-5.283,C_Z1=-9.68,C_L=C_Z0-C_Z1,C_PERIOD=2*C_L/.8;
function predictedCartZ(i,dtPhysical=0){const t=(cartTime+dtPhysical+i*C_PERIOD/3)%C_PERIOD,d=.8*t;return d<=C_L?C_Z0-d:C_Z1+(d-C_L)}

function validatePolyline(points,guard){for(let i=0;i<points.length-1;i++){const a=points[i],b=points[i+1],dist=a.distanceTo(b),n=Math.max(2,Math.ceil(dist/.03));for(let k=0;k<=n;k++){const p=a.clone().lerp(b,k/n);if(!guard(p))return false}}return true}
const PREFLIGHT_OK=validatePolyline(A_SAFE,clearAStatic);
function cartDist(cart,p){return Math.hypot(p.x-cart.position.x,p.z-cart.position.z)}
async function waitForCWindow(cart,idx,token){
 setSafety('GAP CHECK','run',`C${idx}：預測 1.7 s 穿越時間窗`);
 const ci=idx-1;
 while(true){
  await waitRun(token);
  let safe=true,min=99;
  for(let dt=0;dt<=1.7;dt+=.12){const gap=Math.abs(predictedCartZ(ci,dt)-CROSS_Z);min=Math.min(min,gap);if(gap<CRASH_GAP+.28){safe=false;break}}
  ui.clearance.textContent=min.toFixed(2)+' m';
  if(safe&&Math.abs(cart.position.z-CROSS_Z)>SAFE_GAP){setSafety('SAFE WINDOW','ok',`C${idx}：預測最小間距 ${min.toFixed(2)} m，授權穿越`);return}
  await sleep(45)
 }
}
async function crossC(cart,idx,token){const x=C_TRACK_X[idx-1],pre=new THREE.Vector3(x-.96,0,CROSS_Z),post=new THREE.Vector3(x+.96,0,CROSS_Z);await moveTo(robotA,pre,.9,token,ui.aSpeed,`Robot A：C${idx} safety gate`);for(let attempt=1;attempt<=3;attempt++){await waitForCWindow(cart,idx,token);crossingRobot=true;try{await moveTo(robotA,post,1.25,token,ui.aSpeed,`C${idx} 授權穿越`,cand=>cartDist(cart,cand)>CRASH_GAP);crossingRobot=false;setSafety('SAFE','ok',`C${idx} 穿越完成，無接觸`);addScore('C',4,`C${idx} 無碰撞`);return}catch(e){crossingRobot=false;if(!(e instanceof SafetyRetry))throw e;setSafety('REPLAN','run',`C${idx} 動態障礙進入保護距離，回退重試`);log(`C${idx} crossing aborted before collision · retry ${attempt}`,'warn');await sleep(120)}}throw new Error(`C${idx} safety window unavailable`)}

async function runRobotA(token,{stopAtD=false}={}){pill(ui.aState,'RUNNING','run');beaconA.visible=true;setStep('a0','active');await follow(robotA,[new THREE.Vector3(13.18,0,-2.15),new THREE.Vector3(13.20,0,-2.55)],.8,token,ui.aSpeed,'Robot A：A 起點 → 空棧板');robotA.attach(pallet);pallet.position.set(0,.18,-1.10);pallet.rotation.set(0,0,0);addS