hot(s){s.parent.add(s.o);s.o.position.copy(s.pos);s.o.quaternion.copy(s.quat);s.o.scale.copy(s.scale);s.o.visible=s.visible}
function resetMission(increment=true){if(increment)missionEpoch++;running=false;paused=false;estop=false;stopTimer();ui.clock.textContent='20:00';ui.phase.textContent='READY';pill(ui.aState,'STANDBY');pill(ui.bState,'STANDBY');pill(ui.handshake,'WAIT');pill(ui.visionState,'IDLE');pill(ui.safety,'SAFE','ok');ui.mode.textContent='AUTONOMOUS';ui.aReady.textContent='NO';ui.bReady.textContent='0/6';ui.dToken.textContent='FREE';ui.bCleared.textContent='NO';aAtD=false;bSortDone=false;basketsAtD=0;handshakeDone=false;bClearedD=false;dOwner=null;srcIndex={D:0,E:0,F:0,G:0};robotA.position.copy(initialA);robotA.quaternion.copy(initialARot);robotB.position.copy(initialB);robotB.quaternion.copy(initialBRot);snapshots.forEach(restoreSnapshot);resetScore();ui.visionText.textContent='等待 QR / 物料辨識';ui.missionProgress.style.width='0%';ui.clearance.textContent='—';setSafety('SAFE','ok','No conflict · path reservation ready');beaconA.visible=beaconB.visible=false;ui.planText.textContent='等待命令';log('Digital Twin reset')}

// ---------- Deterministic language command planner ----------
const PLAN={
 FULL:{label:'完整系統整合',plan:'雙機同步 → A配送 + B在E分揀 → A@D → B逐籃移載 → handshake → B清空D → A出貨'},
 DELIVERY:{label:'Robot A 配送示範',plan:'取棧板 → 130cm → 8° → C1/C2/C3安全時窗 → D停靠'},
 SORTING:{label:'Robot B 分揀示範',plan:'掃描訂單 → 25件分揀 → 6籃完成 → E終點'},
 PAUSE:{label:'暫停',plan:'凍結機器動作；保留任務狀態'},RESUME:{label:'繼續',plan:'從目前節點繼續'},RESET:{label:'重置',plan:'取消目前任務 → 回到 READY'},ESTOP:{label:'緊急停止',plan:'立即停止驅動；計時持續'},RELEASE_ESTOP:{label:'解除急停',plan:'復歸安全狀態'},VIEW_D:{label:'D區鏡頭',plan:'切換到 D 交握區'},VIEW_E:{label:'E區鏡頭',plan:'切換到 E 分揀區'},VIEW_ALL:{label:'總覽鏡頭',plan:'切換全場總覽'}
};
function normalizeText(t){return (t||'').normalize('NFKC').toUpperCase().replace(/[，。！？,.!?\s]/g,'').replace(/欸機|A機器|機器A/g,'A機').replace(/B機器|機器B/g,'B機')}
function parseIntent(text){const s=normalizeText(text);if(!s)return {intent:'UNKNOWN',confidence:0};
 if(/解除(急停|緊急停止)|復歸/.test(s))return {intent:'RELEASE_ESTOP',confidence:.99};
 if(/緊急停止|急停|ESTOP|停止所有/.test(s))return {intent:'ESTOP',confidence:.99};
 if(/重置|重新開始|回到初始|RESET/.test(s))return {intent:'RESET',confidence:.98};
 if(/暫停|停一下|PAUSE/.test(s))return {intent:'PAUSE',confidence:.97};
 if(/繼續|恢復|RESUME/.test(s))return {intent:'RESUME',confidence:.97};
 if(/完整流程|完整競賽|系統整合|開始比賽|開始完整|執行完整/.test(s))return {intent:'FULL',confidence:.98};
 if(/配送任務|A機.*(配送|搬運)|只跑A|ROBOT A/.test(s))return {intent:'DELIVERY',confidence:.95};
 if(/分揀任務|B機.*分揀|六籃|只跑B|ROBOT B/.test(s))return {intent:'SORTING',confidence:.95};
 if(/D區|交握鏡頭|看D/.test(s))return {intent:'VIEW_D',confidence:.88};
 if(/E區|分揀鏡頭|看E/.test(s))return {intent:'VIEW_E',confidence:.88};
 if(/總覽|全場|俯瞰/.test(s))return {intent:'VIEW_ALL',confidence:.9};
 return {intent:'UNKNOWN',confidence:.1};}
function showIntent(text,result,source='TEXT'){ui.heard.textContent=text||'—';ui.intent.textContent=result.intent==='UNKNOWN'?'UNKNOWN':`${result.intent} · ${PLAN[result.intent].label}`;ui.planText.textContent=result.intent==='UNKNOWN'?'未對應到安全命令；不執行。請使用建議語句。':PLAN[result.intent].plan;pill(ui.voiceState,result.intent==='UNKNOWN'?'NO MATCH':source,result.intent==='UNKNOWN'?'stop':'ok')}
async function executeIntent(result){const i=result.intent;if(i==='UNKNOWN'){toast('命令不明確，已拒絕執行');return}if(['FULL','DELIVERY','SORTING'].includes(i)&&running){toast('已有任務執行中；先暫停、重置或急停');return}if(i==='FULL')return runFull();if(i==='DELIVERY')return runDeliveryOnly();if(i==='SORTING')return runSortingOnly();if(i==='PAUSE'){paused=true;ui.phase.textContent='PAUSED';ui.mode.textContent='PAUSED';log('Task planner：PAUSE','warn');return}if(i==='RESUME'){paused=false;ui.phase.textContent=running?'RUNNING':'READY';ui.mode.textContent='AUTONOMOUS';log('Task planner：RESUME','ok');return}if(i==='RESET'){resetMission(true);return}if(i==='ESTOP'){estop=true;$('estop').classList.add('active');pill(ui.safety,'E-STOP','stop');ui.mode.textContent='DRIVE POWER CUT';log('E-STOP：所有驅動暫停','err');return}if(i==='RELEASE_ESTOP'){estop=false;$('estop').classList.remove('active');pill(ui.safety,'SAFE','ok');ui.mode.textContent='AUTONOMOUS';log('E-STOP RELEASED','ok');return}if(i==='VIEW_D')return viewD();if(i==='VIEW_E')return viewE();if(i==='VIEW_ALL')return viewOverview()}
async function dispatchText(text,source='TEXT',forced=null){const r=forced?{intent:forced,confidence:1}:parseIntent(text);showIntent(text||PLAN[forced]?.label||'',r,source);if(r.confidence<.55||r.intent==='UNKNOWN')return;await executeIntent(r)}

$('exec').onclick=()=>dispatchText(ui.command.value,'TEXT');ui.command.onkeydown=e=>{if(e.key==='Enter')dispatchText(ui.command.value,'TEXT')};$('reset').onclick=()=>dispatchText('重置','BUTTON','RESET');$('estop').onclick=()=>dispatchText(estop?'解除急停':'緊急停止','BUTTON',estop?'RELEASE_ESTOP':'ESTOP');document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>dispatchText(PLAN[b.dataset.intent]?.label||b.textContent,'BUTTON',b.dataset.intent));
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const rec=new SR();rec.lang='zh-TW';rec.continuous=false;rec.interimResults=true;rec.maxAlternatives=5;let finalHandled=false;rec.onstart=()=>{finalHandled=false;pill(ui.voiceState,'LISTENING','run');$('mic').classList.add('voice-listening');ui.heard.textContent='聆聽中…'};rec.onresult=e=>{const result=e.results[e.results.length-1];let best=null;for(let i=0;i<result.length;i++){const t=result[i].transcript,r=parseIntent(t),score=(r.intent==='UNKNOWN'?0:.5)+(result[i].confidence||.5);if(!best||score>best.score)best={t,r,score}}if(best)ui.heard.textContent=best.t;if(result.isFinal&&best&&!finalHandled){finalHandled=true;showIntent(best.t,best.r,'VOICE');if(best.r.confidence>=.55&&best.r.intent!=='UNKNOWN')executeIntent(best.r);else toast('語音不明確，未執行')}};rec.onend=()=>{$('mic').classList.remove('voice-listening');if(!finalHandled)pill(ui.voiceState,'READY')};rec.onerror=e=>{pill(ui.voiceState,'VOICE ERROR','stop');ui.planText.textContent='語音辨識錯誤：'+e.error;$('mic').classList.remove('voice-listening')};$('mic').onclick=()=>{try{rec.start()}catch{}}}else{$('mic').disabled=true;ui.planText.textContent='此瀏覽器未提供 Web Speech API；仍可使用文字與按鈕。'}

// ---------- Cameras ----------
function tweenCam(p,t){camera.position.copy(p);controls.target.copy(t);controls.update()}function viewOverview(){tweenCam(new THREE.Vector3(40,28,34),new THREE.Vector3(14,0,-3))}function viewD(){tweenCam(new THREE.Vector3(30,12,8),new THREE.Vector3(22,0,-2.5))}function viewE(){tweenCam(new THREE.Vector3(31,9,10),new THREE.Vector3(25.5,.6,1.1))}$('viewOverview').onclick=viewOverview;$('viewTop').onclick=()=>tweenCam(new THREE.Vector3(14,44,-3),new THREE.Vector3(14,0,-3));$('viewD').onclick=viewD;$('viewE').onclick=viewE;

// RGB-D from tool0 / fallback E view.
const rgbR=new THREE.WebGLRenderer({canvas:$('rgb'),antialias:true}),depthR=new THREE.WebGLRenderer({canvas:$('depth')}),rgbCam=new THREE.PerspectiveCamera