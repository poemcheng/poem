(()=>{
if(!window.THREE){alert('Three.js 載入失敗，請確認網路連線。');return}
const $=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ui={stateA:$('stateA'),stateB:$('stateB'),safety:$('safetyState'),basket:$('basketProg'),score:$('scoreNum'),meter:$('scoreMeter'),scoreState:$('scoreState'),mode:$('modeB'),zone:$('zoneB'),speed:$('speedB'),battery:$('batteryB'),visionLine:$('visionLine'),visionDetect:$('visionDetect'),log:$('log'),materialGrid:$('materialGrid'),orderBody:$('orderBody'),notice:$('notice'),modelState:$('modelState'),navState:$('navState'),moveitState:$('moveitState'),rosState:$('rosState'),jointRead:$('jointRead'),navInfo:$('navInfo')};
const ORDERS=[{id:1,D:1,E:4,F:0,G:0},{id:2,D:2,E:1,F:2,G:0},{id:3,D:0,E:3,F:1,G:0},{id:4,D:0,E:0,F:2,G:1},{id:5,D:1,E:1,F:0,G:2},{id:6,D:0,E:2,F:2,G:0}];
const PRODUCT={D:[{code:'D1',name:'醫療口罩盒'},{code:'D2',name:'防護口罩盒'}],E:[{code:'E1',name:'食品禮盒'},{code:'E2',name:'營養補充盒'}],F:[{code:'F1',name:'香皂組'},{code:'F2',name:'清潔皂組'}],G:[{code:'G1',name:'牙膏禮盒'},{code:'G2',name:'口腔清潔盒'}]};
let chosen={},materialLayout=['D','E','F','G'],halted=false,running=false,battery=96,score={pick:0,correct:0,basket:0,pallet:0},doneBaskets=new Set(),activeBasket=0;
function log(s,type=''){const d=document.createElement('div');d.textContent=`${new Date().toLocaleTimeString('zh-TW',{hour12:false})}  ${s}`;if(type==='ok')d.style.color='#7ee09a';if(type==='warn')d.style.color='#ffd17f';if(type==='err')d.style.color='#ff8b9b';ui.log.prepend(d)}
function notice(s){ui.notice.textContent=s;ui.notice.classList.add('show');setTimeout(()=>ui.notice.classList.remove('show'),1700)}
function tag(el,text,cls=''){el.textContent=text;el.className='tag '+cls}
function updateScore(){const total=score.pick+score.correct+score.basket+score.pallet;ui.score.textContent=total;ui.meter.style.width=(total/65*100)+'%';$('c1').textContent=`${score.pick} / 25`;$('c2').textContent=`${score.correct} / 25`;$('c3').textContent=`${score.basket} / 12`;$('c4').textContent=`${score.pallet} / 3`;$('b1').style.width=(score.pick/25*100)+'%';$('b2').style.width=(score.correct/25*100)+'%';$('b3').style.width=(score.basket/12*100)+'%';$('b4').style.width=(score.pallet/3*100)+'%';tag(ui.scoreState,total===65?'COMPLETE':running?'RUNNING':'READY',total===65?'ok':running?'run':'')}
function renderOrders(){ui.orderBody.innerHTML='';ORDERS.forEach(o=>{const tr=document.createElement('tr');if(o.id===activeBasket)tr.classList.add('active');if(doneBaskets.has(o.id))tr.classList.add('done');tr.innerHTML=`<td>B-${o.id}</td><td>${o.D}</td><td>${o.E}</td><td>${o.F}</td><td>${o.G}</td><td>${doneBaskets.has(o.id)?'✓':'—'}</td>`;ui.orderBody.appendChild(tr)});ui.basket.textContent=`${doneBaskets.size} / 6`}
function randomizeDraw(){for(const c of ['D','E','F','G']) chosen[c]=PRODUCT[c][Math.floor(Math.random()*2)];materialLayout=['D','E','F','G'].sort(()=>Math.random()-.5);ui.materialGrid.innerHTML='';for(const c of ['D','E','F','G']){const card=document.createElement('div');card.className='matCard';card.innerHTML=`<b>${c} 類</b><small>2 抽 1</small><div class="chosen">${chosen[c].code}</div><small>${chosen[c].name}</small>`;ui.materialGrid.appendChild(card)}log('完成當日物料抽籤：'+['D','E','F','G'].map(c=>chosen[c].code).join(' / '),'ok')}
renderOrders();randomizeDraw();updateScore();
const {MIO_GLB_URI,UR7E_URDF}=window.TRCDemoAssets;
const UR_JOINTS=['shoulder_pan_joint','shoulder_lift_joint','elbow_joint','wrist_1_joint','wrist_2_joint','wrist_3_joint'];
const scene=new THREE.Scene();scene.background=new THREE.Color(0x0a1218);scene.fog=new THREE.Fog(0x0a1218,38,88);
const camera=new THREE.PerspectiveCamera(48,innerWidth/innerHeight,.1,180);camera.position.set(31,25,34);
const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;renderer.useLegacyLights=false;document.body.prepend(renderer.domElement);
const controls=new THREE.OrbitControls(camera,renderer.domElement);controls.target.set(0,1,0);controls.enableDamping=true;controls.dampingFactor=.06;controls.maxPolarAngle=Math.PI*.48;controls.minDistance=16;controls.maxDistance=70;
scene.add(new THREE.HemisphereLight(0xb8d8e5,0x1a1712,1.1));
const key=new THREE.DirectionalLight(0xffffff,4.2);key.position.set(8,20,10);key.castShadow=true;key.shadow.mapSize.set(2048,2048);key.shadow.camera.left=-30;key.shadow.camera.right=30;key.shadow.camera.top=30;key.shadow.camera.bottom=-30;scene.add(key);
for(let x=-16;x<=16;x+=8){const l=new THREE.PointLight(0xdff5ff,45,18,2);l.position.set(x,8,0);scene.add(l)}
const MAT={floor:new THREE.MeshStandardMaterial({color:0x4b5255,roughness:.9,metalness:.05}),steel:new THREE.MeshStandardMaterial({color:0x4f5960,roughness:.38,metalness:.72}),dark:new THREE.MeshStandardMaterial({color:0x151c21,roughness:.45,metalness:.5}),blue:new THREE.MeshStandardMaterial({color:0x0d5a91,roughness:.4,metalness:.5}),white:new THREE.MeshStandardMaterial({color:0xe8eceb,roughness:.38,metalness:.28}),orange:new THREE.MeshStandardMaterial({color:0xd57822,roughness:.6,metalness:.1}),wood:new THREE.MeshStandardMaterial({color:0x8d6036,roughness:.8}),basket:new THREE.MeshStandardMaterial({color:0x164f56,roughness:.55,metalness:.2}),glass:new THREE.MeshStandardMaterial({color:0x96c8d7,roughness:.18,metalness:.15,transparent:true,opacity:.36}),rubber:new THREE.MeshStandardMaterial({color:0x101315,roughness:.95}),concrete:new THREE.MeshStandardMaterial({color:0x60676a,roughness:.95})};
function mesh(g,m,x=0,y=0,z=0,cast=true){const o=new THREE.Mesh(g,m);o.position.set(x,y,z);o.castShadow=cast;o.receiveShadow=true;scene.add(o);return o}function addBox(parent,w,h,d,m,x=0,y=0,z=0){const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;parent.add(o);return o}
// Factory shell
mesh(new THREE.PlaneGeometry(44,28),MAT.floor,0,0,0,false).rotation.x=-Math.PI/2;
for(let z=-12;z<=12;z+=4)mesh(new THREE.BoxGeometry(44,.012,.035),new THREE.MeshBasicMaterial({color:0x6c7477,transparent:true,opacity:.18}),0,.012,z,false);
for(let x=-20;x<=20;x+=4)mesh(new THREE.BoxGeometry(.035,.012,28),new THREE.MeshBasicMaterial({color:0x6c7477,transparent:true,opacity:.18}),x,.013,0,false);
// safety aisles
function floorMark(w,d,color,x,z,opacity=.72){const m=new THREE.Mesh(new THREE.PlaneGeometry(w,d),new THREE.MeshBasicMaterial({color,transparent:true,opacity,side:THREE.DoubleSide}));m.rotation.x=-Math.PI/2;m.position.set(x,.018,z);scene.add(m);return m}
floorMark(2.6,22,0x223746,0,0,.23);floorMark(44,.18,0xf0c748,0,-11.6,.9);floorMark(44,.18,0xf0c748,0,11.6,.9);floorMark(.18,28,0xf0c748,-19.6,0,.9);floorMark(.18,28,0xf0c748,19.6,0,.9);
// structural columns and beams
for(const x of [-18,-9,0,9,18])for(const z of [-12,12]){mesh(new THREE.BoxGeometry(.34,7,.34),MAT.steel,x,3.5,z);}
for(const x of [-18,-9,0,9,18])mesh(new THREE.BoxGeometry(.3,.3,24),MAT.steel,x,7.1,0);
for(const z of [-11.8,11.8])mesh(new THREE.BoxGeometry(40,.26,.26),MAT.steel,0,7.1,z);
// walls partial
mesh(new THREE.BoxGeometry(44,4,.18),new THREE.MeshStandardMaterial({color:0x737b7d,roughness:.8}),0,2,-13.1);mesh(new THREE.BoxGeometry(.18,4,26),new THREE.MeshStandardMaterial({color:0x737b7d,roughness:.8}),-21.1,2,0);
function textTexture(lines,bg='#0b1d28',fg='#e9f6fb',accent='#2dd7c5'){const c=document.createElement('canvas');c.width=768;c.height=256;const x=c.getContext('2d');x.fillStyle=bg;x.fillRect(0,0,c.width,c.height);x.fillStyle=accent;x.fillRect(0,0,16,c.height);x.fillStyle=fg;x.font='700 56px Microsoft JhengHei, sans-serif';x.fillText(lines[0],48,84);x.fillStyle='#9fc4d4';x.font='34px Microsoft JhengHei, sans-serif';x.fillText(lines[1]||'',48,150);x.font='24px Microsoft JhengHei, sans-serif';x.fillText(lines[2]||'',48,205);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t}
function sign(lines,x,y,z,ry=0,w=4,h=1.35){const p=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:textTexture(lines)}));p.position.set(x,y,z);p.rotation.y=ry;scene.add(p);return p}
sign(['ZONE D','出貨準備 / Pallet staging','Basket stacking + handover'],-6,3.3,-11.95,0,5,1.6);sign(['ZONE E','視覺辨識 / Material picking','QR + RGB-D + UR7e'],13,3.3,-11.95,0,5,1.6);
// floor zone highlights
floorMark(12,12,0x63262c,-8,-2,.10);floorMark(12,12,0x0e6260,12,0,.10);floorMark(5,4,0x9b741b,-11,6,.22);floorMark(5,4,0x9b741b,-5,6,.22);floorMark(5,4,0x9b741b,1,6,.22);
// D/E floor labels
function floorLabel(txt,x,z,color){const c=document.createElement('canvas');c.width=512;c.height=256;const ctx=c.getContext('2d');ctx.clearRect(0,0,512,256);ctx.fillStyle=color;ctx.globalAlpha=.85;ctx.fillRect(0,0,512,256);ctx.globalAlpha=1;ctx.fillStyle='#fff';ctx.font='900 150px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(txt,256,128);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const p=new THREE.Mesh(new THREE.PlaneGeometry(3.2,1.6),new THREE.MeshBasicMaterial({map:t,transparent:true,opacity:.65}));p.rotation.x=-Math.PI/2;p.position.set(x,.025,z);scene.add(p)}floorLabel('D',-8,-6,'#7b1d2c');floorLabel('E',13,7,'#06786f');
// realistic workbench helpers
function createBench(x,z,w=7){const g=new THREE.Group();addBox(g,w,.12,1.5,MAT.steel,0,.88,0);for(const sx of [-w/2+.3,w/2-.3])for(const sz of [-.55,.55])addBox(g,.12,.88,.12,MAT.steel,sx,.44,sz);g.position.set(x,0,z);scene.add(g);return g}
function qrTexture(label){const c=document.createElement('canvas');c.width=256;c.height=256;const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const fallback=()=>{const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,256,256);x.fillStyle='#000';x.font='700 20px monospace';x.textAlign='center';x.fillText(label,128,128);t.needsUpdate=true};if(window.QRCode&&QRCode.toCanvas){QRCode.toCanvas(c,label,{width:256,margin:2,errorCorrectionLevel:'M',color:{dark:'#000000',light:'#ffffff'}},err=>{if(err)fallback();t.needsUpdate=true})}else fallback();t.userData={payload:label};return t}
function qrPanel(label,parent,x,y,z,ry=0,s=.55){const p=new THREE.Mesh(new THREE.PlaneGeometry(s,s),new THREE.MeshBasicMaterial({map:qrTexture(label)}));p.position.set(x,y,z);p.rotation.y=ry;parent.add(p);return p}
function createMaterialStation(){const g=createBench(13,0,8.5);addBox(g,8.2,.25,2.1,new THREE.MeshStandardMaterial({color:0xb8c0c2,roughness:.6}),0,1.03,0);const bins=[];for(let i=0;i<4;i++){const bg=new THREE.Group();const slot=materialLayout[i];addBox(bg,1.75,.28,1.45,MAT.dark,0,.14,0);for(const sx of [-.82,.82])addBox(bg,.08,.55,1.45,MAT.dark,sx,.41,0);addBox(bg,1.7,.55,.08,MAT.dark,0,.41,-.68);qrPanel(slot,bg,0,.57,.73,Math.PI,0.5);const colors={D:0xaec5c6,E:0xcfaa73,F:0xcfd2d6,G:0xbfd5d2};for(let k=0;k<6;k++){c