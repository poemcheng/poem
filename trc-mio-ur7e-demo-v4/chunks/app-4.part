ck=()=>{if(!halted)execute('緊急停止');else execute('解除急停')};
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const rec=new SR();rec.lang='zh-TW';rec.interimResults=false;rec.onresult=e=>{$('command').value=e.results[0][0].transcript;execute($('command').value)};rec.onerror=()=>notice('語音辨識失敗');$('mic').onclick=()=>rec.start()}else{$('mic').disabled=true;$('mic').textContent='語音不支援'}
// animation loop
let t=0,last=performance.now();function animate(now){requestAnimationFrame(animate);const dt=Math.min(.05,(now-last)/1000);last=now;t+=dt; // traffic forklift patrol
if(!halted){trafficFork.position.x=3+Math.sin(t*.45)*7;trafficFork.position.z=6.8+Math.sin(t*.9)*1.3;trafficFork.rotation.y=Math.cos(t*.45)>0?Math.PI/2:-Math.PI/2;updateArmTrajectory(now)}
scanRing.material.opacity=.055+.035*Math.sin(t*3);controls.update();for(const b of badges){const p=b.pos.clone().project(camera);const x=(p.x*.5+.5)*innerWidth,y=(-p.y*.5+.5)*innerHeight;b.el.style.left=x+'px';b.el.style.top=y+'px';b.el.style.display=(p.z>1||x<0||x>innerWidth||y<0||y>innerHeight)?'none':'block'}renderer.render(scene,camera);
// Optical camera follows UR7e tool frame when available; otherwise AMR front sensor frame
const cp=new THREE.Vector3();if(urTool){urTool.getWorldPosition(cp)}else{cp.set(0,1.15,.45);robotB.localToWorld(cp)}rgbCam.position.copy(cp);const look=new THREE.Vector3();if(ui.zone.textContent.startsWith('E'))look.set(13,.9,0);else{look.set(0,1,2.5);robotB.localToWorld(look)}rgbCam.lookAt(look);rgbRenderer.render(scene,rgbCam);const oldOverride=scene.overrideMaterial,oldBg=scene.background,oldFog=scene.fog;scene.overrideMaterial=depthMat;scene.background=new THREE.Color(0xffffff);scene.fog=null;depthRenderer.render(scene,rgbCam);scene.overrideMaterial=oldOverride;scene.background=oldBg;scene.fog=oldFog;}requestAnimationFrame(animate);
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
log('Digital Twin ready · 等待競賽任務');setVision('—','camera online · waiting target',.99);
})();
