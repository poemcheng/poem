function createForklift(color=0xd38b19){const g=new THREE.Group();addBox(g,1.8,.55,2.6,new THREE.MeshStandardMaterial({color,roughness:.55,metalness:.25}),0,.45,0);addBox(g,1.5,1.5,1.2,MAT.dark,0,1.4,.2);for(const sx of [-.72,.72])for(const sz of [-.8,.8]){const w=new THREE.Mesh(new THREE.CylinderGeometry(.28,.28,.22,20),MAT.rubber);w.rotation.z=Math.PI/2;w.position.set(sx,.28,sz);g.add(w)}addBox(g,.15,2.8,.15,MAT.steel,-.62,1.55,-1.45);addBox(g,.15,2.8,.15,MAT.steel,.62,1.55,-1.45);addBox(g,.1,.12,2.2,MAT.steel,-.33,.32,-2.0);addBox(g,.1,.12,2.2,MAT.steel,.33,.32,-2.0);return g}const trafficFork=createForklift();trafficFork.position.set(2,0,10);scene.add(trafficFork);
