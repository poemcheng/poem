function createFallbackBase(parent){addBox(parent,1.52,.48,.96,new THREE.MeshStandardMaterial({color:0xe2e8ea,roughness:.35,metalness:.35}),0,.38,0);addBox(parent,1.56,.12,1.0,MAT.blue,0,.18,0)}
function loadMioGLB(parent){if(!THREE.GLTFLoader){createFallbackBase(parent);return}const loader=new THREE.GLTFLoader();loader.load(MIO_GLB_URI,gltf=>{const m=gltf.scene;m.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});parent.add(m);ui.modelState.textContent='MIO GLB + UR7e URDF';log('MIO AMR GLB asset loaded','ok')},undefined,e=>{createFallbackBase(parent);ui.modelState.textContent='MIO fallback + UR7e URDF';log('MIO GLB 載入失敗，使用幾何備援','warn')})}
function loadUR7e(parent,host){if(typeof URDFLoader==='undefined'){ui.modelState.textContent='URDFLoader unavailable';log('URDFLoader 未載入','warn');return}try{const loader=new URDFLoader();const robot=loader.parse(UR7E_URDF);robot.rotation.x=-Math.PI/2;robot.scale.set(1,1,1);robot.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});parent.add(robot);ur7eRobot=robot;host.userData.urdf=robot;host.userData.joints=robot.joints||{};urTool=robot.links&&robot.links.tool0?robot.links.tool0:null;ui.modelState.textContent='MIO GLB + UR7e URDF';log('UR7e URDF + official visual meshes loaded','ok');setUrJoints(POSES.home)}catch(e){ui.modelState.textContent='URDF parse error';log('UR7e URDF 載入錯誤：'+e.message,'err')}}
function createRobotB(){const g=new THREE.Group();const baseRoot=new THREE.Group();g.add(baseRoot);loadMioGLB(baseRoot);const armMount=new THREE.Group();armMount.position.set(-.08,.79,0);g.add(armMount);g.userData={base:baseRoot,armMount,cargo:null,urdf:null,joints:{}};setTimeout(()=>loadUR7e(armMount,g),0);return g}
const robotB=createRobotB();robotB.position.set(11,0,9.2);scene.add(robotB);
