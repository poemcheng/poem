onst pkg=addBox(bg,.28,.12,.55,new THREE.MeshStandardMaterial({color:colors[slot],roughness:.65}),-0.55+(k%3)*.55,.5+(k>2?.13:0),-0.18+(k%2)*.18);pkg.rotation.y=(k%2)*.3}bg.position.set(-3.1+i*2.05,1.08,0);g.add(bg);bins.push({cat:slot,group:bg})}return {group:g,bins}}
