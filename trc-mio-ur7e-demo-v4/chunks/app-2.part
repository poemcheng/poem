function createBasket(id){const g=new THREE.Group();const w=1.25,d=.85,h=.78;addBox(g,w,.1,d,MAT.basket,0,.06,0);for(let yy=.17;yy<h;yy+=.18){addBox(g,.08,.08,d,MAT.basket,-w/2,yy,0);addBox(g,.08,.08,d,MAT.basket,w/2,yy,0);addBox(g,w,.08,.08,MAT.basket,0,yy,-d/2);addBox(g,w,.08,.08,MAT.basket,0,yy,d/2)}for(const sx of [-w/2,w/2])for(const sz of [-d/2,d/2])addBox(g,.08,h,.08,MAT.basket,sx,h/2,sz);const o=ORDERS[id-1],payload=`Basket-${id}-D${o.D}-E${o.E}-F${o.F}-G${o.G}`;qrPanel(payload,g,0,.38,d/2+.005,0,.42);g.userData={id,items:[]};return g}
