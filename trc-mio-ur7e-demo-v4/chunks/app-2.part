function cnc(x,z,label){const g=new THREE.Group();addBox(g,4.2,3.8,3.1,new THREE.MeshStandardMaterial({color:0xdddeda,roughness:.38,metalness:.35}),0,1.9,0);addBox(g,2.15,2.25,.1,MAT.glass,-.45,2.1,1.56);addBox(g,.68,2.25,.28,MAT.dark,1.42,2.1,1.55);addBox(g,.42,.38,.15,new THREE.MeshStandardMaterial({color:0x20292e}),1.42,2.55,1.75);const beacon=new THREE.Mesh(new THREE.CylinderGeometry(.1,.1,.55,16),new THREE.MeshStandardMaterial({color:0x1e2123}));beacon.position.set(1.5,4.1,0);g.add(beacon);g.position.set(x,0,z);scene.add(g);sign([label,'CNC Machining Center','Machine tending interface'],x,4.9,z-1.57,0,3.5,1.1)}cnc(-14,-1,'MC-01');cnc(-14,8.5,'MC-02');
