function routeLine(points,color){const curve=new THREE.CatmullRomCurve3(points.map(p=>new THREE.Vector3(p[0],.045,p[1])));const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,90,.045,8,false),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.72}));scene.add(tube);return tube}
