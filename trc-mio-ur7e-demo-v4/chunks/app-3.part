sition.z-trafficFork.position.z);if(df<2.15){motionSpeed=0;ui.speed.textContent='0.00 m/s';ui.safety.textContent='PROTECTIVE STOP';ui.safety.className='tag stop';ui.navState.textContent='LOCAL STOP';if(!blockedSince){blockedSince=now;log('Nav2 local_costmap：動態堆高機進入 inflation layer','warn')}if(now-blockedSince>650){replan()}requestAnimationFrame(step);return}else if(blockedSince){ui.safety.textContent='NORMAL';ui.safety.className='tag ok';blockedSince=0}
if(idx>=path.length){motionSpeed=0;ui.speed.textContent='0.00 m/s';ui.mode.textContent='IDLE';ui.navState.textContent='GOAL REACHED';tag(ui.stateB,'READY','ok');resolve();return}const wp=path[idx],dx=wp.x-obj.position.x,dz=wp.z-obj.position.z,d=Math.hypot(dx,dz);if(d<.12){idx++;requestAnimationFrame(step);return}const stepLen=Math.min(d,speed*dt*2.4);obj.position.x+=dx/d*stepLen;obj.position.z+=dz/d*stepLen;obj.rotation.y=Math.atan2(dx,dz);motionSpeed=speed;ui.speed.textContent=speed.toFixed(2)+' m/s';battery=Math.max(20,battery-stepLen*.012);ui.battery.textContent=battery.toFixed(0)+'%';requestAnimationFrame(step)}requestAnimationFrame(step)})}

const POSES={home:[0,-1.57,1.57,-1.57,-1.57,0],scan:[-.55,-1.15,1.42,-1.72,-1.57,.45],pick:[-.72,-1.46,1.82,-1.88,-1.57,.28],carry:[-.12,-1.02,1.34,-1.86,-1.57,0]};let currentQ=[...POSES.home];
function setUrJoints(q){currentQ=[...q];if(ur7eRobot&&ur7eRobot.joints){UR_JOINTS.forEach((n,i)=>{const j=ur7eRobot.joints[n];if(j&&j.setJointValue)j.setJointValue(q[i])})}ui.jointRead.textContent='q=['+q.map(v=>v.toFixed(2)).join(', ')+']'}
function armPose(mode){const target=POSES[mode]||POSES.home;activeArmTraj={name:mode,from:[...currentQ],to:[...target],t0:performance.now(),dur:mode==='pick'?520:420};ui.moveitState.textContent='PLANNING → EXECUTE';log(`MoveIt2 JointTrajectory: ${mode} pose`)}
function updateArmTrajectory(now){if(!activeArmTraj)return;const u=clamp((now-activeArmTraj.t0)/activeArmTraj.dur,0,1),e=u*u*u*(10+u*(-15+6*u));const q=activeArmTraj.from.map((a,i)=>a+(activeArmTraj.to[i]-a)*e);setUrJoints(q);if(u>=1){ui.moveitState.textContent='TRAJECTORY OK';activeArmTraj=null}}
armPose('home');
function setVision(code,desc,conf=.98){ui.visionLine.textContent=`QR / class=${code} / confidence=${conf.toFixed(3)}`;ui.visionDetect.textContent=desc}
function addProductToBasket(basket,cat){const colors={D:0xb8d5d6,E:0xd1af7f,F:0xd7d9da,G:0xaecbc7};const item=new THREE.Mesh(new THREE.BoxGeometry(cat==='G'?.52:.38,.12,.26),new THREE.MeshStandardMaterial({color:colors[cat],roughness:.58}));const n=basket.userData.items.length,itemX=-.42+(n%3)*.42,itemZ=-.23+(Math.floor(n/3)%3)*.23,itemY=.17+Math.floor(n/9)*.13;item.position.set(itemX,itemY,itemZ);basket.add(item);basket.userData.items.push(item)}
async function pickItemsForBasket(order){activeBasket=order.id;renderOrders();tag(ui.stateB,'PICKING','run');ui.mode.textContent='VISION PICK';const basket=basketModels[order.id-1];const orderPayload=`Basket-${order.id}-D${order.D}-E${order.E}-F${order.F}-G${order.G}`;setVision(orderPayload,`真實 QR 解碼：D${order.D} E${order.E} F${order.F} G${order.G}`,.999);log(`QR decode → ${orderPayload}`);await sleep(480);for(const cat of ['D','E','F','G']){for(let i=0;i<order[cat];i++){await waitRun();armPose('scan');const p=chosen[cat];setVision(p.code,`${cat} 類辨識：${p.name}`,.965+Math.random()*.032);log(`RGB-D + QR：辨識 ${p.code} (${p.name})`);await sleep(140);armPose('pick');await sleep(110);addProductToBasket(basket,cat);score.pick=Math.min(25,score.pick+1);score.correct=Math.min(25,score.correct+1);updateScore();await sleep(80)}}armPose('carry');tag(ui.stateB,'READY','ok');ui.mode.textContent='IDLE'}
function attachToRobot(basket){const wp=new THREE.Vector3();basket.getWorldPosition(wp);basketRack.remove(basket);robotB.add(basket);basket.position.set(0,1.05,-.15);basket.rotation.set(0,0,0);robotB.userData.cargo=basket}
function stackOnPallet(basket,index){robotB.remove(basket);pallet.add(basket);const layer=Math.floor(index/2),side=index%2;basket.position.set(side?0.75:-0.75,.54+layer*.82,0);basket.rotation.set(0,0,0);pallet.userData.loaded.push(basket);robotB.userData.cargo=null}
async function robotBAllBaskets(){if(doneBaskets.size===6){log('B 機六個出貨籃已完成','ok');return}tag(ui.stateB,'MISSION','run');for(const o of ORDERS){if(doneBaskets.has(o.id))continue;await waitRun();await move(robotB,P.BASKET,1.2,`B 機前往 Basket-${o.id} 取籃`,true);ui.zone.textContent='E · BASKET';await pickItemsForBasket(o);attachToRobot(basketModels[o.id-1]);log(`Basket-${o.id} 完成 物料正確配置，載入 AMR`,'ok');await move(robotB,P.D_DOCK,1.2,`Basket-${o.id} → D 區棧板`,true);ui.zone.textContent='D · PALLET';armPose('pick');await sleep(300);stackOnPallet(basketModels[o.id-1],doneBaskets.size);armPose('home');doneBaskets.add(o.id);score.basket=Math.min(12,score.basket+2);renderOrders();updateScore();log(`Basket-${o.id} 已堆疊至棧板（層 ${Math.floor((doneBaskets.size-1)/2)+1}）`,'ok');if(doneBaskets.size<6)await move(robotB,P.BASKET,1.2,'B 機返回 E 區進行下一籃',true)}activeBasket=0;renderOrders();tag(ui.stateB,'BASKETS DONE','ok')}
async function AtoD(){tag(ui.stateA,'MOVING','run');log('A 機：由起始區搬運空棧板至 D 區'); // attach pallet to A
scene.remove(pallet);robotA.add(pallet);pallet.position.set(0,.42,-1.6);await move(robotA,P.D_DOCK,1.35,'A 機載運棧板 → D 區',false);robotA.remove(pallet);scene.add(pallet);pallet.position.set(P.D_DOCK.x,.1,P.D_DOCK.z);tag(ui.stateA,'D READY','ok');log('A 機：棧板已送達 D 區，等待 B 機','ok')}
async function BtoEEnd(){await move(robotB,P.E_END,1.2,'B 機完成六籃後 → E 區起(終)點',true);ui.zone.textContent='E END';tag(ui.stateB,'FINISHED','ok');log('B 機抵達 E 終點','ok')}
async function Aship(){if(doneBaskets.size<6){log('A 出貨前需先完成 6 個出貨籃堆疊','warn');return}tag(ui.stateA,'PICK PALLET','run');await move(robotA,P.D_DOCK,1.35,'A 機前往 D 區取堆疊棧板');scene.remove(pallet);robotA.add(pallet);pallet.position.set(0,.42,-1.6);await move(robotA,P.SHIP1,1.35,'A 機將棧板移至任意出貨區');robotA.remove(pallet);scene.add(pallet);pallet.position.set(P.SHIP1.x,.1,P.SHIP1.z);score.pallet=3;updateScore();log('棧板已送至出貨區，+3 分','ok');await move(robotA,P.A_END,1.35,'A 機 → D 區終點');tag(ui.stateA,'FINISHED','ok')}
async function fullMission(){if(running)return;running=true;updateScore();tag(ui.scoreState,'RUNNING','run');log('=== 開始完整競賽情境 ===');await AtoD();await robotBAllBaskets();await BtoEEnd();await Aship();running=false;updateScore();if(score.pick===25&&score.correct===25&&score.basket===12&&score.pallet===3){tag(ui.scoreState,'65 / 65','ok');notice('競賽情境完成：65 / 65');log('=== 任務完成：65 / 65 ===','ok')}}
function resetAll(){if(running){notice('任務執行中，請先 E-STOP 再重置');return}halted=false;$('estop').classList.remove('active');ui.safety.textContent='NORMAL';ui.safety.className='tag ok';robotA.position.copy(P.A_STAGING);robotA.rotation.set(0,0,0);robotB.position.copy(P.E_END);robotB.rotation.set(0,0,0);battery=96;ui.battery.textContent='96%';score={pick:0,correct:0,basket:0,pallet:0};doneBaskets.clear();activeBasket=0; // recreate basket content / placement
for(let i=0;i<basketModels.length;i++){const b=basketModels[i];if(b.parent)b.parent.remove(b);while(b.userData.items.length){const item=b.userData.items.pop();b.remove(item)}basketRack.add(b);b.position.set(-3.6+i*1.45,1.07,0);b.rotation.set(0,0,0)}if(pallet.parent)pallet.parent.remove(pallet);scene.add(pallet);pallet.position.set(-15,.1,-8.8);pallet.rotation.set(0,0,0);pallet.userData.loaded=[];randomizeDraw();renderOrders();updateScore();tag(ui.stateA,'STANDBY');tag(ui.stateB,'STANDBY');ui.zone.textContent='E END';ui.mode.textContent='IDLE';ui.speed.textContent='0.00 m/s';navReplans=0;ui.navState.textContent='Costmap ready';ui.navInfo.textContent='global_plan: idle · local_costmap: clear';armPose('home');setVision('—','等待任務',.99);log('系統已重置','ok')}
async function execute(text){text=(text||'').trim();if(!text)return;log('COMMAND > '+text);if(/緊急|急停|停止/.test(text)){halted=true;$('estop').classList.add('active');ui.safety.textContent='E-STOP';ui.safety.className='tag stop';notice('E-STOP engaged');log('安全迴路：E-STOP 啟動','err');return}if(/解除|恢復/.test(text)){halted=false;$('estop').classList.remove('active');ui.safety.textContent='NORMAL';ui.safety.className='tag ok';log('E-STOP 已解除','ok');return}if(/重置/.test(text)){resetAll();return}if(/重新抽籤|抽籤/.test(text)){if(running){notice('任務執行中不可重新抽籤');return}randomizeDraw();return}if(/完整/.test(text)){fullMission();return}if(/A.*D|送棧板/.test(text)){AtoD();return}if(/B.*六|六個出貨籃/.test(text)){robotBAllBaskets();return}if(/B.*E|E終點/.test(text)){BtoEEnd();return}if(/A.*出貨|完成出貨/.test(text)){Aship();return}const m=text.match(/Basket[- ]?(\d)/i);if(m){const n=+m[1],o=ORDERS[n-1];setVision('Basket-'+n,`D${o.D} E${o.E} F${o.F} G${o.G}`,.999);log(`Basket-${n}：D${o.D}, E${o.E}, F${o.F}, G${o.G}`);return}if(/物料區/.test(text)){move(robotB,P.MAT,1.2,'B 機 → E 物料區',true);return}notice('未辨識指令')}
// ROS2 read-only bridge: accepts real Nav2 path, joint_states, MoveIt DisplayTrajectory when rosbridge is available
let ros=null,rosSubs=[];function connectROS(){if(!window.ROSLIB){notice('ROSLIB 未載入');return}if(ros){try{ros.close()}catch(e){}ros=null;ui.rosState.textContent='SIM / OFFLINE';$('rosConnect').textContent='READ-ONLY CONNECT';return}const url=$('rosUrl').value.trim();ui.rosState.textContent='CONNECTING';ros=new ROSLIB.Ros({url});ros.on('connection',()=>{ui.rosState.textContent='CONNECTED / READ';$('rosConnect').textContent='DISCONNECT';log('ROS2 rosbridge connected (read-only)','ok');const js=new ROSLIB.Topic({ros,name:'/joint_states',messageType:'sensor_msgs/JointState'});js.subscribe(msg=>{if(!msg.name||!msg.position)return;const q=UR_JOINTS.map(n=>{const i=msg.name.indexOf(n);return i>=0?msg.position[i]:0});setUrJoints(q);ui.moveitState.textContent='LIVE JOINT_STATES'});rosSubs.push(js);const plan=new ROSLIB.Topic({ros,name:'/plan',messageType:'nav_msgs/Path'});plan.subscribe(msg=>{if(!msg.poses||!msg.poses.length)return;const pts=msg.poses.map(p=>new THREE.Vector3(p.pose.position.x,.09,p.pose.position.y));drawNav(pts,0x31e6c4);ui.navState.textContent='LIVE /plan';ui.navInfo.textContent=`ROS2 nav_msgs/Path: ${pts.length} poses`});rosSubs.push(plan);const disp=new ROSLIB.Topic({ros,name:'/move_group/display_planned_path',messageType:'moveit_msgs/DisplayTrajectory'});disp.subscribe(msg=>{try{const jt=msg.trajectory[0].joint_trajectory,pt=jt.points[jt.points.length-1],names=jt.joint_names;const q=UR_JOINTS.map(n=>pt.positions[names.indexOf(n)]||0);activeArmTraj={name:'ros2-plan',from:[...currentQ],to:q,t0:performance.now(),dur:900};ui.moveitState.textContent='LIVE DISPLAY TRAJ'}catch(e){}});rosSubs.push(disp)});ros.on('error',()=>{ui.rosState.textContent='CONNECTION ERROR';log('ROS bridge connection error','warn')});ros.on('close',()=>{ui.rosState.textContent='SIM / OFFLINE';ros=null})}
$('rosConnect').onclick=connectROS;
$('exec').onclick=()=>execute($('command').value);$('command').onkeydown=e=>{if(e.key==='Enter')$('exec').click()};document.querySelectorAll('[data-cmd]').forEach(b=>b.onclick=()=>{$('command').value=b.dataset.cmd;execute(b.dataset.cmd)});$('estop').oncli