async function runRobotA({stopAtD=false}={}){pill(ui.aState,'RUNNING','run');beaconA.visible=true;setStep('a0','active');await follow(robotA,[new THREE.Vector3(13.2,0,-2.6),new THREE.Vector3(13.1,0,-3.15)],1.05,'Robot A：A 起點取空棧板',ui.aSpeed);robotA.attach(pallet);pallet.position.set(0,.19,-.78);addScore('A',4,'棧板完全移出存放區');setStep('a0','done');setStep('a1','active');await follow(robotA,[new THREE.Vector3(11.0,0,-.72),new THREE.Vector3(9.8,0,-.72),new THREE.Vector3(8.5,0,-1.35),new THREE.Vector3(7.6,0,-.55),new THREE.Vector3(6.25,0,-1.25),new THREE.Vector3(5.55,0,-2.25),new THREE.Vector3(4.05,0,-2.55),new THREE.Vector3(3.0,0,-3.75),new THREE.Vector3(.9,0,-4.25)],.95,'A 區：130 cm 窄道 → A1/A2/A3 靜態避障',ui.aSpeed);addScore('A',20,'130 cm 窄道完全通過');addScore('A',4,'A1 完全通過');addScore('A',4,'A2 完全通過');addScore('A',4,'A3 完全通過');setStep('a1','done');setStep('a2','active');await follow(robotA,[new THREE.Vector3(.9,0,-5.8),new THREE.Vector3(4.2,0,-9.15),new THREE.Vector3(5.77,h8,-9.15),new THREE.Vector3(8.27,h8,-9.15),new THREE.Vector3(9.82,0,-9.15),new THREE.Vector3(13.35,0,-9.05)],.82,'B 區：8° 負重斜坡',ui.aSpeed);addScore('B',10,'8° 上坡完成');addScore('B',10,'8° 下坡完成');setStep('a2','done');setStep('a3','active');await follow(robotA,[new THREE.Vector3(15.1,0,-8.7)],.92,'C 區：進入 C1/C2/C3',ui.aSpeed);for(let i=0;i<3;i++){await waitCartClear(dynamicCarts[i],dynamicCarts[i].position.x);await moveTo(robotA,new THREE.Vector3(dynamicCarts[i].position.x,0,-7.45+i*.18),.9,`C${i+1} 無碰撞通過`,ui.aSpeed);addScore('C',4,`C${i+1} 無碰撞`)}await follow(robotA,[new THREE.Vector3(27.0,0,-5.7),new THREE.Vector3(24.8,0,-3.25)],.95,'Robot A：抵達 D 等待交握',ui.aSpeed);setStep('a3','done');setStep('a4','active');aAtD=true;ui.aReady.textContent='YES';pill(ui.aState,'WAIT @ D','run');if(stopAtD){log('Robot A 單機配送展示：抵達 D 區等待 B','ok');beaconA.visible=false;return}await waitHandshake();setStep('a4','done');setStep('a5','active');await follow(robotA,[new THREE.Vector3(22.45,0,-1.1)],.78,'Robot A：出貨棧板移至出貨區',ui.aSpeed);addScore('ship',3,'出貨棧板完成出貨');await follow(robotA,[new THREE.Vector3(27.05,0,-4.0)],.95,'Robot A：移動至 D 終點',ui.aSpeed);setStep('a5','done');pill(ui.aState,'FINISHED','ok');beaconA.visible=false}

function itemSlot(n){return new THREE.Vector3((n%3-1)*.12,.25+Math.floor(n/3)*.08,(n%2?-.06:.06))}
async function pickOne(cat,basket,slot){const item=sources[cat][srcIndex[cat]++];if(!item)return;const sku=SKU[cat];await follow(robotB,[new THREE.Vector3(26.78,0,1.52)],.72,`Robot B：精準靠站物料區 ${cat}`,ui.bSpeed);pill(ui.visionState,'DETECTED','ok');ui.visionText.textContent=`物料格 QR=${cat} · ${sku} · ${SKU_NAME[sku]} · 6D pose / grasp OK`;await armPose('scan',220);await armPose('pick',280);scene.attach(item);await moveTo(item,new THREE.Vector3(robotB.position.x,.98,robotB.position.z),1.6,null,null);robotB.attach(item);item.position.set(.20,1.02,0);const dockX=clamp(basket.position.x,23.45,26.55);await follow(robotB,[new THREE.Vector3(dockX,0,1.13)],.72,`Robot B：靠站 Basket-${basket.userData.id}`,ui.bSpeed);await armPose('basket',260);basket.attach(item);item.position.copy(itemSlot(slot));item.rotation.set(0,.15*(slot%3),0);addScore('pick',1,`${sku} 取出`);addScore('basket',1,`${sku} 正確放入 Basket-${basket.userData.id}`);await armPose('carry',220)}
async function carryBasketToD(basket,i){const bx=basket.position.x;await follow(robotB,[new THREE.Vector3(clamp(bx,23.45,26.55),0,1.13)],.75,`Robot B：靠站 Basket-${basket.userData.id} 取籃`,ui.bSpeed);scene.attach(basket);await moveTo(basket,new THREE.Vector3(robotB.position.x,.9,robotB.position.z),1.4,'UR7e：出貨籃移載到 AMR',null);robotB.attach(basket);basket.position.set(0,.72,-.18);await follow(robotB,[new THREE.Vector3(25.2,0,.25),new THREE.Vector3(24.55,0,-2.45)],1.05,`Robot B：Basket-${basket.userData.id} → D`,ui.bSpeed);const layer=Math.floor(i/2),side=i%2;robotA.updateMatrixWorld(true);pallet.attach(basket);basket.position.set(side?.22:-.22,.22+layer*.24,0);basket.rotation.set(0,Math.PI/2,0);addScore('stack',2,`Basket-${basket.userData.id} 堆疊 Layer ${layer+1} · QR 朝場內側`);basketsAtD++;ui.bReady.textContent=basketsAtD+'/6';if(basketsAtD<6)await follow(robotB,[new THREE.Vector3(25.5,0,.3),new THREE.Vector3(25.7,0,1.25)],1.05,'Robot B：返回 E 區',ui.bSpeed)}
