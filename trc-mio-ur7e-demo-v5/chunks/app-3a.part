function makeBeacon(parent,y){const g=new THREE.Group(),mat=new THREE.MeshStandardMaterial({color:0xffc34a,emissive:0xff8b00,emissiveIntensity:2});const lamp=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.09,18),mat);lamp.position.y=y;g.add(lamp);parent.add(g);g.visible=false;return g}const beaconA=makeBeacon(robotA,1.94),beaconB=makeBeacon(robotB,1.62);

