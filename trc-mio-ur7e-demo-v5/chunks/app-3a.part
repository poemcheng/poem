ost)}
if(window.TRCDemoAssets?.MIO_GLB_URI){new GLTFLoader().load(window.TRCDemoAssets.MIO_GLB_URI,g=>{const q=g.scene;const bb=new THREE.Box3().setFromObject(q),sz=bb.getSize(new THREE.Vector3());q.scale.set(.85/Math.max(sz.x,.001),.85/Math.max(sz.x,.001),.85/Math.max(sz.x,.001));q.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});baseHost.add(q)},undefined,fallbackB)}else fallbackB();
try{const xml=window.TRCDemoAssets?.UR7E_URDF;if(xml){const u=new URDFLoader();urdfRobot=u.parse(xml);urdfRobot.rotation.x=-Math.PI/2;urdfRobot.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});armMount.add(urdfRobot);tool0=urdfRobot.links?.tool0||null;log('UR7e 官方 kinematics / visual mesh 已載入','ok')}}catch(e){log('URDF loader fallback：'+e.message,'warn')}
