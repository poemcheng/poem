function startTimer(){stopTimer();let r=1200;timerHandle=setInterval(()=>{r--;ui.clock.textContent=`${String(Math.floor(r/60)).padStart(2,'0')}:${String(r%60).padStart(2,'0')}`;if(r<=0){stopTimer();halted=true;ui.phase.textContent='TIMEOUT';pill(ui.safety,'STOP','stop');log('20 分鐘時間到：未完成項目停止計分','err')}},1000)}function stopTimer(){if(timerHandle)clearInterval(timerHandle);timerHandle=null}

$('run').onclick=runFull;$('reset').onclick=resetMission;$('estop').onclick=()=>{halted=!halted;$('estop').classList.toggle('active',halted);pill(ui.safety,halted?'E-STOP':'SAFE',halted?'stop':'ok');ui.mode.textContent=halted?'DRIVE POWER CUT':'AUTONOMOUS';log(halted?'E-STOP：驅動停止；競賽計時持續':'E-STOP RELEASE','warn')};document.querySelectorAll('.chip').forEach(b=>b.onclick=async()=>{const c=b.dataset.cmd;if(c==='pause'){paused=!paused;ui.phase.textContent=paused?'SIM PAUSED':'RUNNING'}else if(c==='delivery'&&!running){resetMission();running=true;ui.phase.textContent='DELIVERY DEMO';startTimer();await runRobotA({stopAtD:true});running=false;stopTimer()}else if(c==='sorting'&&!running){resetMission();running=true;ui.phase.textContent='SORTING DEMO';startTimer();await runRobotB({standalone:true});running=false;stopTimer()}else if(c==='handshake'){aAtD=true;basketsAtD=6;ui.aReady.textContent='YES';ui.bReady.textContent='6/6';await maybeHandshake()}});ui.command.onkeydown=e=>{if(e.key==='Enter')runFull()};
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const r=new SR();r.lang='zh-TW';r.onresult=e=>{ui.command.value=e.results[0][0].transcript;if(/完整|開始|執行/.test(ui.command.value))runFull()};$('mic').onclick=()=>r.start()}else $('mic').disabled=true;

function frameScene(){controls.target.set(14,0,-3.1);camera.position.set(39,29,33);controls.update()}function tweenCamera(p,t){camera.position.copy(p);controls.target.copy(t);controls.update()}$('viewOverview').onclick=frameScene;$('viewTop').onclick=()=>tweenCamera(new THREE.Vector3(14,43,-3),new THREE.Vector3(14,0,-3));$('viewE').onclick=()=>tweenCamera(new THREE.Vector3(32,10,10),new THREE.Vector3(25,0,1));
const rgbR=new THREE.WebGLRenderer({canvas:$('rgb'),antialias:true}),depthR=new THREE.WebGLRenderer({canvas:$('depth')}),rgbCam=new THREE.PerspectiveCamera(60,1.8,.06,15),depthMat=new THREE.MeshDepthMaterial({depthPacking:THREE.BasicDepthPacking});
function updateCams(){const w=$('rgb').clientWidth||130,h=$('rgb').clientHeight||72;rgbR.setSize(w,h,false);depthR.setSize(w,h,false);rgbCam.aspect=w/h;rgbCam.updateProjectionMatrix();if(tool0){const p=new THREE.Vector3();tool0.getWorldPosition(p);rgbCam.position.copy(p);rgbCam.lookAt(27.2,.7,1.4)}else{rgbCam.position.set(26.1,1.55,2.3);rgbCam.lookAt(27.3,.7,1.4)}rgbR.render(scene,rgbCam);const old=scene.overrideMaterial;scene.overrideMaterial=depthMat;depthR.render(scene,rgbCam);scene.overrideMaterial=old}
const cclock=new THREE.Clock();let blink=0;function animate(){requestAnimationFrame(animate);const dt=cclock.getDelta();if(!paused&&!halted){cartTime+=dt;const z0=-5.25,z1=-9.72,L=z0-z1,period=2*L/.8;dynamicCarts.forEach((c,i)=>{const t=(cartTime+i*period/3)%period,d=.8*t;c.position.z=d<=L?z0-d:z1+(d-L)})}blink+=dt;const vis=Math.sin(blink*9)>0;if(running){beaconA.visible=vis;beaconB.visible=vis}controls.update();renderer.render(scene,camera);updateCams();ui.zoneHud.textContent=`A (${robotA.position.x.toFixed(1)},${(-robotA.position.z).toFixed(1)}) m · B (${robotB.position.x.toFixed(1)},${(-robotB.position.z).toFixed(1)}) m`}animate();
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});updateScore();frameScene();ui.loading.classList.add('hide');log('TRC2026 ZIP / 手冊實尺寸場景建立完成','ok');
