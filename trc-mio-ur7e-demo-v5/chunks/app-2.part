-Math.PI/2;m.position.set(x,.006,z);scene.add(m);return m}
for(const x of [2.37,4.57,6.77,8.97])markRect(x,-2.47,.05,4.84,0x151515,.85);

// A-zone: exact 600×300×300 mm stainless boxes, 36 boxes, using ZIP assembly positions.
