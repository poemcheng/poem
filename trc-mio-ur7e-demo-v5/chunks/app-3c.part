坡',ui.aSpeed);addScore('B',10,'8° 上坡完成');addScore('B',10,'8° 下坡完成');setStep('a2','done');setStep('a3','active');await follow(robotA,[new THREE.Vector3(15.1,0,-8.7)],.92,'C 區：進入 C1/C2/C3',ui.aSpeed);for(let i=0;i<3;i++){await waitCartClear(dynamicCarts[i],dynamicCarts[i].position.x);await moveTo(robotA,new THREE.Vector3(dynamicCarts[i].position.x,0,-7.45+i*.18),.9,`C${i+1} 無碰撞通過`,ui.aSpeed);addScore('C',4,`C${i+1} 無碰撞`)}await follow(robotA,[new THREE.Vector3(27.0,0,-5.7),new THREE.Vector3(24.8,0,-3.25)],.95,'Robot A：抵達 D 等待交握',ui.aSpeed);setStep('a3','done');setStep('a4','active');aAtD=true;ui.aReady.textContent='YES';pill(ui.aState,'WAIT @ D','run');await waitHandshake();setStep('a4','done');setStep('a5','active');await follow(robotA,[new THREE.Vector3(22.45,0,-1.1)],.78,'Robot A：出貨棧板移至出貨區',ui.aSpeed);addScore('ship',3,'出貨棧板完成出貨');await follow(robotA,[new THREE.Vector3(27.05,0,-4.0)],.95,'Robot A：移動至 D 終點',ui.aSpeed);setStep('a5','done');pill(ui.aState,'FINISHED','ok');beaconA.visible=false}

function itemSlot(n){return new THREE.Vector3((n%3-1)*.12,.25+Math.floor(n/3)*.08,(n%2?-.06:.06))}
async function pickOne(cat,basket,slot){const item=sources[cat][srcIndex[cat]++];if(!item)return;const sku=SKU[cat];await follow(robotB,[new THREE.Vector3(26.78,0,1.52)],.72,`Robot B：精準靠站物料區 ${cat}`,ui.bSpeed);pill(ui.visionState,'DETECTED','ok');ui.visionText.textContent=`物料格 QR=${cat} · ${sku} · ${SKU_NAME[sku]} · 6D pose / grasp OK`;await armPose('scan',220);await armPose('pick',280);scene.attach(item);await moveTo(item,new THREE.Vector3(robotB.position.x,.98,robotB.position.z),1.6,null,null);robotB.attach(item);item.position.set(.20,1.02,0);const dockX=clamp(basket.position.x,23.45,26.55);await follow(robotB,[new THREE.Vector3(dockX,0,1.13)],.72,`Robot B：靠站 Basket-${basket.userData.id}`,ui.bSpeed);await armPose('basket',260);basket.attach(item);item.position.copy(itemSlot(slot));item.rotation.set(0,.15*(slot%3),0);addScore('pick',1,`${sku} 取出`);addScore('basket',1,`${sku} 正確放入 Basket-${basket.userData.id}`);await armPose('carry',220)}
