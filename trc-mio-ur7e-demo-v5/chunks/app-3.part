Host);const armMount=new THREE.Group();armMount.position.set(0,.62,0);robotB.add(armMount);let urdfRobot=null,tool0=null;
function fallbackB(){meshBox(.85,.36,.65,MAT.white,0,.3,0,baseHost);meshBox(.86,.09,.66,MAT.blue,0,.14,0,baseHost)}
if(window.TRCDemoAssets?.MIO_GLB_URI){new GLTFLoader().load(window.TRCDemoAssets.MIO_GLB_URI,g=>{const q=g.scene;const bb=new THREE.Box3().setFromObject(q),sz=bb.getSize(new THREE.Vector3());q.scale.set(.85/Math.max(sz.x,.001),.85/Math.max(sz.x,.001),.85/Math.max(sz.x,.001));q.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});baseHost.add(q)},undefined,fallbackB)}else fallbackB();
try{const xml=window.TRCDemoAssets?.UR7E_URDF;if(xml){const u=new URDFLoader();urdfRobot=u.parse(xml);urdfRobot.rotation.x=-Math.PI/2;urdfRobot.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});armMount.add(urdfRobot);tool0=urdfRobot.links?.tool0||null;log('UR7e 官方 kinematics / visual mesh 已載入','ok')}}catch(e){log('URDF loader fallback：'+e.message,'warn')}
const JOINT_POSE={home:[-90,-65,110,-135,-90,0],scan:[-72,-72,100,-116,-90,12],pick:[-56,-92,118,-118,-90,30],carry:[-90,-58,96,-128,-90,0],basket:[-112,-78,112,-126,-90,-12]};const rosJoint=['shoulder_pan_joint','shoulder_lift_joint','elbow_joint','wrist_1_joint','wrist_2_joint','wrist_3_joint'];

function makeBeacon(parent,y){const g=new THREE.Group(),mat=new THREE.MeshStandardMaterial({color:0xffc34a,emissive:0xff8b00,emissiveIntensity:2});const lamp=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.09,18),mat);lamp.position.y=y;g.add(lamp);parent.add(g);g.visible=false;return g}const beaconA=makeBeacon(robotA,1.94),beaconB=makeBeacon(robotB,1.62);

let paused=false,halted=false,running=false,aAtD=false,basketsAtD=0,handshakeDone=false,timerHandle=null,cartTime=0,srcIndex={D:0,E:0,F:0,G:0};
const initialA=robotA.position.clone(),initialB=robotB.position.clone(),initialPallet=pallet.position.clone(),initialBaskets=baskets.map(b=>b.position.clone());
function setStep(id,state){document.querySelectorAll('.steps li').forEach(li=>{if(li.dataset.step===id){li.classList.remove('active','done');if(state)li.classList.add(state)}})}function clearSteps(){document.querySelectorAll('.steps li').forEach(li=>li.classList.remove('active','done'))}function orderState(i,state){const e=$('order-'+i);e.classList.remove('active','done');if(state)e.classList.add(state)}
async function waitRun(){while(paused||halted)await sleep(80)}
function moveTo(obj,to,speed,label,speedEl){return new Promise(resolve=>{const from=obj.position.clone(),dist=from.distanceTo(to),dur=Math.max(240,dist/Math.max(speed,.1)*260),st=performance.now(),last=from.clone();if(label)log(label);function step(now){if(paused||halted){requestAnimationFrame(step);return}const u=clamp((now-st)/dur,0,1),e=u*u*(3-2*u);obj.position.lerpVectors(from,to,e);const dx=to.x-from.x,dz=to.z-from.z;if(Math.hypot(dx,dz)>.01)obj.rotation.y=Math.atan2(dx,dz);if(speedEl){const ds=obj.position.distanceTo(last);speedEl.textContent=Math.min(1.95,ds*60).toFixed(2)+' m/s';last.copy(obj.position)}if(u<1)requestAnimationFrame(step);else{if(speedEl)speedEl.textContent='0.00 m/s';resolve()}}requestAnimationFrame(step)})}
async function follow(obj,pts,speed,label,el){if(label)log(label);for(const p of pts){await waitRun();await moveTo(obj,p,speed,null,el)}}
async function armPose(name,ms=440){if(!urdfRobot)return;const tgt=JOINT_POSE[name];const start=rosJoint.map(n=>urdfRobot.joints?.[n]?.angle||0),st=performance.now();pill(ui.bState,'MOVEIT2 '+name.toUpperCase(),'run');return new Promise(resolve=>{function s(now){if(paused||halted){requestAnimationFrame(s);return}const u=clamp((now-st)/ms,0,1),e=u*u*(3-2*u);rosJoint.forEach((n,i)=>urdfRobot.joints?.[n]?.setJointValue(THREE.MathUtils.lerp(start[i],THREE.MathUtils.degToRad(tgt[i]),e)));if(u<1)requestAnimationFrame(s);else resolve()}requestAnimationFrame(s)})}

async function waitCartClear(cart,xCross){while(true){await waitRun();if(Math.abs(cart.position.z+7.5)>1.0){pill(ui.safety,'SAFE','ok');return}pill(ui.safety,'PROTECTIVE STOP','run');ui.mode.textContent='WAITING';log(`C 區 safety scanner：track @ x=${xCross.toFixed(3)} m occupied`,'warn');await sleep(150)}}
async function runRobotA(){pill(ui.aState,'RUNNING','run');beaconA.visible=true;setStep('a0','active');await follow(robotA,[new THREE.Vector3(13.2,0,-2.6),new THREE.Vector3(13.1,0,-3.15)],1.05,'Robot A：A 起點取空棧板',ui.aSpeed);robotA.attach(pallet);pallet.position.set(0,.19,-.78);addScore('A',4,'棧板完全移出存放區');setStep('a0','done');setStep('a1','active');await follow(robotA,[new THREE.Vector3(11.0,0,-.72),new THREE.Vector3(9.8,0,-.72),new THREE.Vector3(8.5,0,-1.35),new THREE.Vector3(7.6,0,-.55),new THREE.Vector3(6.25,0,-1.25),new THREE.Vector3(5.55,0,-2.25),new THREE.Vector3(4.05,0,-2.55),new THREE.Vector3(3.0,0,-3.75),new THREE.Vector3(.9,0,-4.25)],.95,'A 區：130 cm 窄道 → A1/A2/A3 靜態避障',ui.aSpeed);addScore('A',20,'130 cm 窄道完全通過');addScore('A',4,'A1 完全通過');addScore('A',4,'A2 完全通過');addScore('A',4,'A3 完全通過');setStep('a1','done');setStep('a2','active');await follow(robotA,[new THREE.Vector3(.9,0,-5.8),new THREE.Vector3(4.2,0,-9.15),new THREE.Vector3(5.77,h8,-9.15),new THREE.Vector3(8.27,h8,-9.15),new THREE.Vector3(9.82,0,-9.15),new THREE.Vector3(13.35,0,-9.05)],.82,'B 區：8° 負重斜坡',ui.aSpeed);addScore('B',10,'8° 上坡完成');addScore('B',10,'8° 下坡完成');setStep('a2','done');setStep('a3','active');await follow(robotA,[new THREE.Vector3(15.1,0,-8.7)],.92,'C 區：進入 C1/C2/C3',ui.aSpeed);for(let i=0;i<3;i++){await waitCartClear(dynamicCarts[i],dynamicCarts[i].position.x);await moveTo(robotA,new THREE.Vector3(dynamicCarts[i].position.x,0,-7.45+i*.18),.9,`C${i+1} 無碰撞通過`,ui.aSpeed);addScore('C',4,`C${i+1} 無碰撞`)}await follow(robotA,[new THREE.Vector3(27.0,0,-5.7),new THREE.Vector3(24.8,0,-3.25)],.95,'Robot A：抵達 D 等待交握',ui.aSpeed);setStep('a3','done');setStep('a4','active');aAtD=true;ui.aReady.textContent='YES';pill(ui.aState,'WAIT @ D','run');await waitHandshake();setStep('a4','done');setStep('a5','active');await follow(robotA,[new THREE.Vector3(22.45,0,-1.1)],.78,'Robot A：出貨棧板移至出貨區',ui.aSpeed);addScore('ship',3,'出貨棧板完成出貨');await follow(robotA,[new THREE.Vector3(27.05,0,-4.0)],.95,'Robot A：移動至 D 終點',ui.aSpeed);setStep('a5','done');pill(ui.aState,'FINISHED','ok');beaconA.visible=false}

function itemSlot(n){return new THREE.Vector3((n%3-1)*.12,.25+Math.floor(n/3)*.08,(n%2?-.06:.06))}
async function pickOne(cat,basket,slot){const item=sources[cat][srcIndex[cat]++];if(!item)return;const sku=SKU[cat];pill(ui.visionState,'DETECTED','ok');ui.visionText.textContent=`QR=${cat} · ${sku} · ${SKU_NAME[sku]} · pose / grasp OK`;await armPose('scan',220);await armPose('pick',280);const wp=new THREE.Vector3();item.getWorldPosition(wp);scene.attach(item);await moveTo(item,new THREE.Vector3(robotB.position.x,1.25,robotB.position.z),1.8,null,null);basket.attach(item);item.position.copy(itemSlot(slot));item.rotation.set(0,.15*(slot%3),0);addScore('pick',1,`${sku} 取出`);addScore('basket',1,`${sku} 放入 Basket-${basket.userData.id}`);await armPose('basket',260)}
async function carryBasketToD(basket,i){scene.attach(basket);await moveTo(baske