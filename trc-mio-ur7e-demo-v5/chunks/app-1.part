const $=id=>document.getElementById(id);
const ui={loading:$('loading'),phase:$('phase'),clock:$('clock'),missionProgress:$('missionProgress'),aState:$('aState'),bState:$('bState'),orders:$('orders'),handshake:$('handshake'),aReady:$('aReady'),bReady:$('bReady'),linkState:$('linkState'),score:$('score'),scoreDelivery:$('scoreDelivery'),scoreSorting:$('scoreSorting'),barDelivery:$('barDelivery'),barSorting:$('barSorting'),sA:$('sA'),sB:$('sB'),sC:$('sC'),sPick:$('sPick'),sBasket:$('sBasket'),sStack:$('sStack'),sShip:$('sShip'),penalty:$('penalty'),visionState:$('visionState'),visionText:$('visionText'),aSpeed:$('aSpeed'),bSpeed:$('bSpeed'),obs:$('obs'),mode:$('mode'),safety:$('safety'),log:$('log'),toast:$('toast'),zoneHud:$('zoneHud'),command:$('command')};
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function pill(el,text,cls='idle'){el.textContent=text;el.className='pill '+cls}
function log(msg,cls=''){const d=document.createElement('div');d.className=cls;d.textContent=new Date().toLocaleTimeString('zh-TW',{hour12:false})+'  '+msg;ui.log.prepend(d)}
function toast(msg){ui.toast.textContent=msg;ui.toast.classList.add('show');setTimeout(()=>ui.toast.classList.remove('show'),1800)}

const ORDERS=[
 {id:1,D:1,E:4,F:0,G:0},{id:2,D:2,E:1,F:2,G:0},{id:3,D:0,E:3,F:1,G:0},
 {id:4,D:0,E:0,F:2,G:1},{id:5,D:1,E:1,F:0,G:2},{id:6,D:0,E:2,F:2,G:0}
];
const SKU={D:'D1',E:'E1',F:'F1',G:'G1'};
const SKU_NAME={D1:'華淨 3D 醫療口罩 50入／盒',E1:'家樂氏 COCO格格脆 170g／盒',F1:'美琪 香皂 85g × 6塊',G1:'DARLIE 好來 全亮白清新薄荷牙膏 140g × 2入'};
ORDERS.forEach(o=>{const e=document.createElement('div');e.className='order';e.id='order-'+o.id;e.innerHTML=`<b>Basket-${o.id}</b><small>D${o.D} · E${o.E} · F${o.F} · G${o.G}</small>`;ui.orders.appendChild(e)});

const score={A:0,B:0,C:0,pick:0,basket:0,stack:0,ship:0,penalty:0};
function totalDelivery(){return score.A+score.B+score.C}
function totalSorting(){return score.pick+score.basket+score.stack+score.ship}
function updateScore(){const d=totalDelivery(),s=totalSorting(),t=Math.max(0,d+s+score.penalty);ui.score.textContent=t;ui.scoreDelivery.textContent=`${d} / 68`;ui.scoreSorting.textContent=`${s} / 65`;ui.barDelivery.style.width=(d/68*100)+'%';ui.barSorting.style.width=(s/65*100)+'%';ui.sA.textContent=`${score.A}/36`;ui.sB.textContent=`${score.B}/20`;ui.sC.textContent=`${score.C}/12`;ui.sPick.textContent=`${score.pick}/25`;ui.sBasket.textContent=`${score.basket}/25`;ui.sStack.textContent=`${score.stack}/12`;ui.sShip.textContent=`${score.ship}/3`;ui.penalty.textContent=score.penalty.toFixed(1)}
function addScore(k,v,reason){score[k]+=v;updateScore();if(reason)log(`${reason}  ${v>0?'+':''}${v}`,'ok')}

const scene=new THREE.Scene();scene.background=new THREE.Color(0x07131c);scene.fog=new THREE.Fog(0x07131c,38,72);
const camera=new THREE.PerspectiveCamera(42,innerWidth/innerHeight,.05,160);camera.position.set(37,29,32);
const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.08;renderer.outputColorSpace=THREE.SRGBColorSpace;document.body.prepend(renderer.domElement);
const controls=new OrbitControls(camera,renderer.domElement);controls.target.set(14,0,-3);controls.enableDamping=true;controls.maxPolarAngle=Math.PI/2.05;controls.minDistance=7;controls.maxDistance=70;
scene.add(new THREE.HemisphereLight(0xcbeeff,0x1c2324,1.35));const sun=new THREE.DirectionalLight(0xffffff,2.0);sun.position.set(10,32,10);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-40;sun.shadow.camera.right=40;sun.shadow.camera.top=30;sun.shadow.camera.bottom=-30;scene.add(sun);

let gltfRoot, mixer, robotA, robotB, pallet, tool0, baskets=[], basketGroups=[], sources={D:[],E:[],F:[],G:[]}, dynamicCarts=[];
let paused=false, halted=false, running=false, aAtD=false, basketsAtD=0, handshakeDone=false, missionStart=0, timerHandle=null, demoSpeed=1.0;
let beaconA,beaconB;
const initial={};
const jointNames=['UR7e_shoulder_joint','UR7e_upper_arm_joint','UR7e_forearm_joint','UR7e_wrist_1_joint','UR7e_wrist_2_joint','UR7e_wrist_3_joint'];
let joints=[],urdfRobot=null;const JOINT_POSE={home:[-90,-65,110,-135,-90,0],scan:[-72,-72,100,-116,-90,12],pick:[-56,-92,118,-118,-90,30],carry:[-90,-58,96,-128,-90,0],basket:[-112,-78,112,-126,-90,-12]};

function findExact(name){return gltfRoot.getObjectByName(name)}
function findPrefix(prefix){let out=[];gltfRoot.traverse(o=>{if(o.name&&o.name.startsWith(prefix))out.push(o)});return out}
function world(o){const v=new THREE.Vector3();o.getWorldPosition(v);return v}
function groupAt(objects,anchor){const g=new THREE.Group();scene.add(g);g.position.copy(anchor);objects.filter(Boolean).forEach(o=>g.attach(o));return g}
function makeBeacon(parent,y=1.7){const g=new THREE.Group();const stem=new THREE.Mesh(new THREE.CylinderGeometry(.035,.035,.16,16),new THREE.MeshStandardMaterial({color:0x22272a,metalness:.5,roughness:.4}));stem.position.y=y;g.add(stem);const lightMat=new THREE.MeshStandardMaterial({color:0xffbf2f,emissive:0xff8a00,emissiveIntensity:2});const lamp=new THREE.Mesh(new THREE.CylinderGeometry(.06,.06,.09,20),lightMat);lamp.position.y=y+.12;g.add(lamp);parent.add(g);return {g,lamp,mat:lightMat,on:false}}
function setBeacon(b,on){if(!b)return;b.on=on;b.g.visible=on}

const loader=new GLTFLoader();
const SCENE_CHUNKS=Array.from({length:11},(_,i)=>`./assets/scene-${String(i+1).padStart(2,'0')}.b64`);
async function loadPackedScene(){
 const parts=await Promise.all(SCENE_CHUNKS.map(async u=>{const r=await fetch(u);if(!r.ok)throw new Error(`${u}: HTTP ${r.status}`);return (await r.text()).trim()}));
 const b64=parts.join('');const raw=atob(b64),packed=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)packed[i]=raw.charCodeAt(i);
 let buf=packed.buffer;
 if(packed[0]===0x1f&&packed[1]===0x8b){if(!('DecompressionStream' in window))throw new Error('Browser lacks gzip DecompressionStream');const ds=new DecompressionStream('gzip');buf=await new Response(new Blob([buf]).stream().pipeThrough(ds)).arrayBuffer()}
 return buf;
}
async function loadReferenceScene(){
 try{
  const buf=await loadPackedScene();
  loader.parse(buf,'./assets/',gltf=>{
   gltfRoot=gltf.scene;scene.add(gltfRoot);gltfRoot.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});
   mixer=new THREE.AnimationMixer(gltfRoot);gltf.animations.forEach(c=>mixer.clipAction(c).pl