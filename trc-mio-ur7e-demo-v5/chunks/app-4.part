t,new THREE.Vector3(robotB.position.x,.9,robotB.position.z),1.4,'UR7e：出貨籃移載到 AMR',null);robotB.attach(basket);basket.position.set(0,.72,-.18);await follow(robotB,[new THREE.Vector3(25.2,0,.25),new THREE.Vector3(24.55,0,-2.45)],1.05,`Robot B：Basket-${basket.userData.id} → D`,ui.bSpeed);const layer=Math.floor(i/2),side=i%2;robotA.updateMatrixWorld(true);pallet.attach(basket);basket.position.set(side?-.22:.22,.22+layer*.24,0);basket.rotation.set(0,Math.PI/2,0);addScore('stack',2,`Basket-${basket.userData.id} 堆疊 Layer ${layer+1}`);basketsAtD++;ui.bReady.textContent=basketsAtD+'/6';if(basketsAtD<6)await follow(robotB,[new THREE.Vector3(25.5,0,.3),new THREE.Vector3(25.7,0,1.25)],1.05,'Robot B：返回 E 區',ui.bSpeed)}
async function runRobotB(){pill(ui.bState,'RUNNING','run');beaconB.visible=true;srcIndex={D:0,E:0,F:0,G:0};await follow(robotB,[new THREE.Vector3(25.7,0,1.25)],.9,'Robot B：E 起點 → 分揀工作位',ui.bSpeed);for(const o of ORDERS){orderState(o.id,'active');const b=baskets[o.id-1];b.userData.id=o.id;pill(ui.visionState,'QR BASKET','run');ui.visionText.textContent=`Basket-${o.id} QR → 對照賽前訂單 D${o.D} E${o.E} F${o.F} G${o.G}`;await sleep(170);let slot=0;for(const cat of ['D','E','F','G'])for(let k=0;k<o[cat];k++)await pickOne(cat,b,slot++);orderState(o.id,'done')}pill(ui.visionState,'6 BASKETS READY','ok');for(let i=0;i<6;i++)await carryBasketToD(baskets[i],i);await maybeHandshake();await waitHandshake();await follow(robotB,[new THREE.Vector3(21.9,0,1.53)],1.0,'Robot B：交握後移至 E 終點',ui.bSpeed);pill(ui.bState,'FINISHED','ok');beaconB.visible=false}
async function maybeHandshake(){if(aAtD&&basketsAtD===6&&!handshakeDone){handshakeDone=true;pill(ui.handshake,'HANDSHAKE','run');ui.linkState.textContent='SYNC';log('A/B 通訊交握：A_READY + B_STACK_COMPLETE','ok');await sleep(480);pill(ui.handshake,'ACK','ok');ui.linkState.textContent='ACK';toast('雙機交握完成')}}async function waitHandshake(){while(!handshakeDone){await maybeHandshake();await sleep(90)}}

async function runFull(){if(running)return;running=true;resetScore();ui.phase.textContent='RUNNING';startTimer();beaconA.visible=beaconB.visible=true;log('裁判 START：A/B 同步自主任務','ok');try{await Promise.all([runRobotA(),runRobotB()]);ui.phase.textContent='COMPLETE';ui.missionProgress.style.width='100%';toast(`完成 · ${ui.score.textContent}/133`);log('系統整合完整流程完成','ok')}catch(e){console.error(e);log('任務錯誤：'+e.message,'err')}finally{running=false;stopTimer()}}
function resetScore(){Object.keys(score).forEach(k=>score[k]=0);updateScore();clearSteps();ORDERS.forEach(o=>orderState(o.id,''));aAtD=false;basketsAtD=0;handshakeDone=false;ui.aReady.textContent='NO';ui.bReady.textContent='0/6';ui.linkState.textContent='OPEN';pill(ui.handshake,'WAIT','idle')}
function resetMission(){halted=paused=running=false;stopTimer();ui.clock.textContent='20:00';ui.phase.textContent='READY';pill(ui.aState,'STANDBY');pill(ui.bState,'STANDBY');pill(ui.visionState,'IDLE');pill(ui.safety,'SAFE','ok');ui.mode.textContent='AUTONOMOUS';resetScore();beaconA.visible=beaconB.visible=false;scene.attach(pallet);pallet.position.copy(initialPallet);pallet.rotation.set(0,0,0);robotA.position.copy(initialA);robotA.rotation.set(0,0,0);robotB.position.copy(initialB);robotB.rotation.set(0,0,0);baskets.forEach((b,i)=>{scene.attach(b);b.position.copy(initialBaskets[i]);b.rotation.set(0,0,0)});Object.values(sources).flat().forEach(o=>{o.visible=true;o.userData.taken=false});srcIndex={D:0,E:0,F:0,G:0};ui.visionText.textContent='等待 QR / 物料辨識';ui.missionProgress.style.width='0%';log('場景重置')}
function startTimer(){stopTimer();let r=1200;timerHandle=setInterval(()=>{if(paused||halted)return;r--;ui.clock.textContent=`${String(Math.floor(r/60)).padStart(2,'0')}:${String(r%60).padStart(2,'0')}`;if(r<=0){stopTimer();halted=true;ui.phase.textContent='TIMEOUT';pill(ui.safety,'STOP','stop')}},1000)}function stopTimer(){if(timerHandle)clearInterval(timerHandle);timerHandle=null}

$('run').onclick=runFull;$('reset').onclick=resetMission;$('estop').onclick=()=>{halted=!halted;$('estop').classList.toggle('active',halted);pill(ui.safety,halted?'E-STOP':'SAFE',halted?'stop':'ok');ui.mode.textContent=halted?'DRIVE POWER CUT':'AUTONOMOUS';log(halted?'E-STOP：強制停止所有動作':'E-STOP RELEASE','warn')};document.querySelectorAll('.chip').forEach(b=>b.onclick=async()=>{const c=b.dataset.cmd;if(c==='pause'){paused=!paused;ui.phase.textContent=paused?'PAUSED':'RUNNING'}else if(c==='delivery'&&!running){running=true;resetScore();startTimer();await runRobotA();running=false;stopTimer()}else if(c==='sorting'&&!running){running=true;resetScore();startTimer();await runRobotB();running=false;stopTimer()}else if(c==='handshake'){aAtD=true;basketsAtD=6;ui.aReady.textContent='YES';ui.bReady.textContent='6/6';await maybeHandshake()}});ui.command.onkeydown=e=>{if(e.key==='Enter')runFull()};
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR){const r=new SR();r.lang='zh-TW';r.onresult=e=>{ui.command.value=e.results[0][0].transcript;if(/完整|開始|執行/.test(ui.command.value))runFull()};$('mic').onclick=()=>r.start()}else $('mic').disabled=true;

function frameScene(){controls.target.set(14,0,-3.1);camera.position.set(39,29,33);controls.update()}function tweenCamera(p,t){camera.position.copy(p);controls.target.copy(t);controls.update()}$('viewOverview').onclick=frameScene;$('viewTop').onclick=()=>tweenCamera(new THREE.Vector3(14,43,-3),new THREE.Vector3(14,0,-3));$('viewE').onclick=()=>tweenCamera(new THREE.Vector3(32,10,10),new THREE.Vector3(25,0,1));
const rgbR=new THREE.WebGLRenderer({canvas:$('rgb'),antialias:true}),depthR=new THREE.WebGLRenderer({canvas:$('depth')}),rgbCam=new THREE.PerspectiveCamera(60,1.8,.06,15),depthMat=new THREE.MeshDepthMaterial({depthPacking:THREE.BasicDepthPacking});
function updateCams(){const w=$('rgb').clientWidth||130,h=$('rgb').clientHeight||72;rgbR.setSize(w,h,false);depthR.setSize(w,h,false);rgbCam.aspect=w/h;rgbCam.updateProjectionMatrix();if(tool0){const p=new THREE.Vector3();tool0.getWorldPosition(p);rgbCam.position.copy(p);rgbCam.lookAt(27.2,.7,1.4)}else{rgbCam.position.set(26.1,1.55,2.3);rgbCam.lookAt(27.3,.7,1.4)}rgbR.render(scene,rgbCam);const old=scene.overrideMaterial;scene.overrideMaterial=depthMat;depthR.render(scene,rgbCam);scene.overrideMaterial=old}
const cclock=new THREE.Clock();let blink=0;function animate(){requestAnimationFrame(animate);const dt=cclock.getDelta();if(!paused&&!halted){cartTime+=dt;const z0=-5.25,z1=-9.72,L=z0-z1,period=2*L/.8;dynamicCarts.forEach((c,i)=>{const t=(cartTime+i*period/3)%period,d=.8*t;c.position.z=d<=L?z0-d:z1+(d-L)})}blink+=dt;const vis=Math.sin(blink*9)>0;if(running){beaconA.visible=vis;beaconB.visible=vis}controls.update();renderer.render(scene,camera);updateCams();ui.zoneHud.textContent=`A (${robotA.position.x.toFixed(1)},${(-robotA.position.z).toFixed(1)}) m · B (${robotB.position.x.toFixed(1)},${(-robotB.position.z).toFixed(1)}) m`}animate();
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});updateScore();frameScene();ui.loading.classList.add('hide');log('TRC2026 ZIP / 手冊實尺寸場景建立完成','ok');
