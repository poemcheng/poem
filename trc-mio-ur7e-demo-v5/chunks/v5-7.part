async function runRobotB({standalone=false}={}){pill(ui.bState,'RUNNING','run');beaconB.visible=true;srcIndex={D:0,E:0,F:0,G:0};await follow(robotB,[new THREE.Vector3(25.7,0,1.25)],.9,'Robot B：E 起點 → 分揀工作位',ui.bSpeed);for(let i=0;i<ORDERS.length;i++){const o=ORDERS[i];orderState(o.id,'active');const b=baskets[o.id-1];b.userData.id=o.id;pill(ui.visionState,'QR BASKET','run');ui.visionText.textContent=`Basket-${o.id} QR=Basket-${o.id} → 賽前訂單 D${o.D} E${o.E} F${o.F} G${o.G}`;await sleep(170);let slot=0;for(const cat of ['D','E','F','G'])for(let k=0;k<o[cat];k++)await pickOne(cat,b,slot++);orderState(o.id,'done');await carryBasketToD(b,i)}pill(ui.visionState,'6 BASKETS STACKED','ok');if(standalone){await follow(robotB,[new THREE.Vector3(21.9,0,1.53)],1.0,'Robot B：分揀完成 → E 終點（單機展示）',ui.bSpeed);pill(ui.bState,'FINISHED','ok');beaconB.visible=false;return}await maybeHandshake();await waitHandshake();await follow(robotB,[new THREE.Vector3(21.9,0,1.53)],1.0,'Robot B：交握後移至 E 終點',ui.bSpeed);pill(ui.bState,'FINISHED','ok');beaconB.visible=false}
async function maybeHandshake(){if(aAtD&&basketsAtD===6&&!handshakeDone){handshakeDone=true;pill(ui.handshake,'HANDSHAKE','run');ui.linkState.textContent='SYNC';log('A/B 通訊交握：A_READY + B_STACK_COMPLETE','ok');await sleep(480);pill(ui.handshake,'ACK','ok');ui.linkState.textContent='ACK';toast('雙機交握完成')}}async function waitHandshake(){while(!handshakeDone){await maybeHandshake();await sleep(90)}}

async function runFull(){if(running)return;resetMission();running=true;ui.phase.textContent='PREP';log('賽前 5 分鐘準備：訂單確認 / 程式載入 / A↔B 通訊 / 安全確認','ok');for(const o of ORDERS)log(`訂單QR：Basket-${o.id}-D${o.D}-E${o.E}-F${o.F}-G${o.G}`);await sleep(450);ui.phase.textContent='RUNNING';startTimer();beaconA.visible=beaconB.visible=true;log('裁判 START：A/B 同步自主任務；20:00 開始計時','ok');try{await Promise.all([runRobotA(),runRobotB()]);ui.phase.textContent='COMPLETE';ui.missionProgress.style.width='100%';toast(`完成 · ${ui.score.textContent}/133`);log('系統整合完整流程完成','ok')}catch(e){console.error(e);log('任務錯誤：'+e.message,'err')}finally{running=false;stopTimer()}}
function resetScore(){Object.keys(score).forEach(k=>score[k]=0);updateScore();clearSteps();ORDERS.forEach(o=>orderState(o.id,''));aAtD=false;basketsAtD=0;handshakeDone=false;ui.aReady.textContent='NO';ui.bReady.textContent='0/6';ui.linkState.textContent='OPEN';pill(ui.handshake,'WAIT','idle')}
function resetMission(){halted=paused=running=false;stopTimer();ui.clock.textContent='20:00';ui.phase.textContent='READY';pill(ui.aState,'STANDBY');pill(ui.bState,'STANDBY');pill(ui.visionState,'IDLE');pill(ui.safety,'SAFE','ok');ui.mode.textContent='AUTONOMOUS';resetScore();beaconA.visible=beaconB.visible=false;scene.attach(pallet);pallet.position.copy(initialPallet);pallet.rotation.set(0,0,0);robotA.position.copy(initialA);robotA.rotation.set(0,0,0);robotB.position.copy(initialB);robotB.rotation.set(0,0,0);baskets.forEach((b,i)=>{scene.attach(b);b.position.copy(initialBaskets[i]);b.rotation.set(0,0,0)});initialSources.forEach(s=>{s.parent.attach(s.o);s.o.position.copy(s.p);s.o.quaternion.copy(s.q);s.o.scale.copy(s.s);s.o.visible=true;s.o.userData.taken=false});srcIndex={D:0,E:0,F:0,G:0};ui.visionText.textContent='等待 QR / 物料辨識';ui.missionProgress.style.width='0%';log('場景重置')}
