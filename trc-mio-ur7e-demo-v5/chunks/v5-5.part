const JOINT_POSE={home:[-90,-65,110,-135,-90,0],scan:[-72,-72,100,-116,-90,12],pick:[-56,-92,118,-118,-90,30],carry:[-90,-58,96,-128,-90,0],basket:[-112,-78,112,-126,-90,-12]};const rosJoint=['shoulder_pan_joint','shoulder_lift_joint','elbow_joint','wrist_1_joint','wrist_2_joint','wrist_3_joint'];

function makeBeacon(parent,y){const g=new THREE.Group(),mat=new THREE.MeshStandardMaterial({color:0xffc34a,emissive:0xff8b00,emissiveIntensity:2});const lamp=new THREE.Mesh(new THREE.CylinderGeometry(.055,.055,.09,18),mat);lamp.position.y=y;g.add(lamp);parent.add(g);g.visible=false;return g}const beaconA=makeBeacon(robotA,1.94),beaconB=makeBeacon(robotB,1.62);

let paused=false,halted=false,running=false,aAtD=false,basketsAtD=0,handshakeDone=false,timerHandle=null,cartTime=0,srcIndex={D:0,E:0,F:0,G:0};
const initialA=robotA.position.clone(),initialB=robotB.position.clone(),initialPallet=pallet.position.clone(),initialBaskets=baskets.map(b=>b.position.clone());
const initialSources=Object.values(sources).flat().map(o=>({o,parent:o.parent,p:o.position.clone(),q:o.quaternion.clone(),s:o.scale.clone()}));
function setStep(id,state){document.querySelectorAll('.steps li').forEach(li=>{if(li.dataset.step===id){li.classList.remove('active','done');if(state)li.classList.add(state)}})}function clearSteps(){document.querySelectorAll('.steps li').forEach(li=>li.classList.remove('active','done'))}function orderState(i,state){const e=$('order-'+i);e.classList.remove('active','done');if(state)e.classList.add(state)}
async function waitRun(){while(paused||halted)await sleep(80)}
function moveTo(obj,to,speed,label,speedEl){return new Promise(resolve=>{const from=obj.position.clone(),dist=from.distanceTo(to),dur=Math.max(240,dist/Math.max(speed,.1)*260);let st=performance.now(),lastNow=st,last=from.clone();if(label)log(label);function step(now){if(paused||halted){st+=now-lastNow;lastNow=now;requestAnimationFrame(step);return}lastNow=now;const u=clamp((now-st)/dur,0,1),e=u*u*(3-2*u);obj.position.lerpVectors(from,to,e);const dx=to.x-from.x,dz=to.z-from.z;if(Math.hypot(dx,dz)>.01)obj.rotation.y=Math.atan2(dx,dz);if(speedEl){speedEl.textContent=Math.min(1.95,speed).toFixed(2)+' m/s';last.copy(obj.position)}if(u<1)requestAnimationFrame(step);else{if(speedEl)speedEl.textContent='0.00 m/s';resolve()}}requestAnimationFrame(step)})}
async function follow(obj,pts,speed,label,el){if(label)log(label);for(const p of pts){await waitRun();await moveTo(obj,p,speed,null,el)}}
async function armPose(name,ms=440){if(!urdfRobot)return;const tgt=JOINT_POSE[name];const start=rosJoint.map(n=>urdfRobot.joints?.[n]?.angle||0);let st=performance.now(),lastNow=st;pill(ui.bState,'MOVEIT2 '+name.toUpperCase(),'run');return new Promise(resolve=>{function s(now){if(paused||halted){st+=now-lastNow;lastNow=now;requestAnimationFrame(s);return}lastNow=now;const u=clamp((now-st)/ms,0,1),e=u*u*(3-2*u);rosJoint.forEach((n,i)=>urdfRobot.joints?.[n]?.setJointValue(THREE.MathUtils.lerp(start[i],THREE.MathUtils.degToRad(tgt[i]),e)));if(u<1)requestAnimationFrame(s);else resolve()}requestAnimationFrame(s)})}

async function waitCartClear(cart,xCross){while(true){await waitRun();if(Math.abs(cart.position.z+7.5)>1.0){pill(ui.safety,'SAFE','ok');return}pill(ui.safety,'PROTECTIVE STOP','run');ui.mode.textContent='WAITING';log(`C 區 safety scanner：track @ x=${xCross.toFixed(3)} m occupied`,'warn');await sleep(150)}}
